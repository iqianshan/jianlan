# AC-03 压测原始数据：每跑一轮就新增一批，不入库。
# 只保留 1.0 收口那一轮，作为 docs/ac03-soak-review-2026-11-20.md 的证据。
tools/ac03/results/*
!tools/ac03/results/ac03-20261120-112805.jsonl
!tools/ac03/results/ac03-20261120-112805.log
!tools/ac03/results/ac03-20261120-112805.win.jsonl

# ---------- 运行时产物（便携模式会写到 exe 同级 data/）----------
data/
logs/

# ---------- 生成物 ----------
# 伪语言资源由 tools/i18n/pseudo-loc.py 生成，只用于 AC-11 走查，不随源码分发
src/Jianlan.Core/Localization/Strings.qps-ploc.resx

# ---------- 系统 ----------
Thumbs.db
desktop.ini
.DS_Store

# ---------- 其他 ----------
*.log
*.tmp
*.bak
*.received.*

# 压测用的第三方工具（Sysinternals，不入库）
tools/ac03/procdump*.exe

# Python（tools/ac03 的脚本会被 import，解释器会留下字节码）
__pycache__/
*.pyc

# 真窗口探针的截图与 PowerShell 原始输出（tools/window-drive/_shots/）
tools/window-drive/_shots/

# 上面 *.log 的例外：1.0 收口那一轮的压测日志是文档引用的证据，需入库。
# 规则必须放在 *.log 之后才生效（gitignore 后者优先）。
!tools/ac03/results/ac03-20261120-112805.log
