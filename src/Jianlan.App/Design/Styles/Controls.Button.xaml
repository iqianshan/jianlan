<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        侧栏底部命令（设置）。

        为什么不复用 Button.Toolbar：那个是 32px 见方的图标按钮，横排时靠 Margin 拉开距离；
        放在整条侧栏底部会变成一小块孤零零的方块，与上面的导航项（整行高亮）不是一套语言。
        这里做整宽 + 左对齐 + 图标/文字，悬停底色与 Nav.Item 对齐。

        模板里用了一层透明 Grid 兜底：Border 只有 4px 外边距，不铺满的话
        整宽按钮的左侧 4px 与右侧 4px 点不上，用户会觉得"按钮右边差一点"。
    -->
    <Style x:Key="Button.NavCommand" TargetType="Button">
        <Setter Property="Height" Value="{DynamicResource Size.Row.Comfortable}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="8,0,8,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Inset}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="Bd"
                                Margin="4,0,4,0"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource CornerRadius.Control}"/>
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Surface.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Surface.Pressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        工具栏按钮。规则同列表：颜色一律 DynamicResource（主题切换即时生效），
        尺寸与圆角一律取 DesignTokens，不写字面量（界面实现规则 §15.3）。
    -->
    <Style x:Key="Button.Toolbar" TargetType="Button">
        <Setter Property="Height" Value="{DynamicResource Size.Row.Comfortable}"/>
        <Setter Property="MinWidth" Value="{DynamicResource Size.Row.Comfortable}"/>
        <Setter Property="Padding" Value="8,0,8,0"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Ring}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource CornerRadius.Control}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Surface.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Surface.Pressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--
        面包屑链接：文字即按钮。不做下划线，靠悬停底色提示可点，
        与资源管理器一致；高度取行高以免工具栏被撑高。
    -->
    <Style x:Key="Button.Link" TargetType="Button">
        <Setter Property="Height" Value="{DynamicResource Size.Row.Comfortable}"/>
        <Setter Property="Padding" Value="6,0,6,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Ring}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource CornerRadius.Control}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Surface.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Surface.Pressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        列表列头。左对齐、无外边距，宽度由列定义控制，
        这样列头与行模板用的是同一套列宽，不会错位。
    -->
    <Style x:Key="Button.Header" TargetType="Button">
        <Setter Property="Height" Value="{DynamicResource Size.Row.Header}"/>
        <Setter Property="Padding" Value="6,0,6,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Ring}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource CornerRadius.Control}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Surface.Hover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 地址栏输入框：默认模板会带系统配色，这里显式收窄并去掉焦点光晕 -->
    <Style x:Key="TextBox.Address" TargetType="TextBox">
        <Setter Property="Height" Value="{DynamicResource Size.Row.Comfortable}"/>
        <!-- 前面那行注释说"去掉焦点光晕"，但那之后没有补任何替代：
             Tab 进地址栏/搜索框时只能靠一根闪烁的光标判断。这里补一条内描边 -->
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Inset}"/>
        <Setter Property="Padding" Value="8,0,8,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Content}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Hairline}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource BorderThickness.Hairline}"/>
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}"/>
    </Style>

    <!--
        工具栏搜索框（FR-6.13）。左右各留出一块：左边叠放大镜，右边叠"清除"按钮。
        TextBox 没有 Placeholder，水印由界面叠一层 TextBlock 实现，样式这里只管留白。
    -->
    <Style x:Key="TextBox.Search" TargetType="TextBox" BasedOn="{StaticResource TextBox.Address}">
        <Setter Property="Padding" Value="26,0,24,0"/>
    </Style>

    <!--
        列表行内的重命名编辑框（资源管理器的"再点一次改名"）。
        高度随内容而不是撑满行：32px 的行里塞一个满高输入框，会像给那一行加了边框；
        而 13pt 文字加上 1px 边与 1px 上下留白刚好贴住字形。
        背景取 Surface.Content 而不是透明：行有选中底色，编辑框必须盖住它，
        否则选中的那行看起来像"文字浮在蓝色块上"。
    -->
    <Style x:Key="TextBox.InlineRename" TargetType="TextBox">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Padding" Value="3,1"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Content}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Default}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family.UI}"/>
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Row}"/>
        <!-- 默认焦点光晕是系统蓝，与主题强调色打架；边框本身已经是"正在编辑"的信号 -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>

    <!--
        搜索框里的"清除"小按钮。不复用 Button.Toolbar：那个最小宽度 32，
        会把 32px 高的输入框撑出一个方块，看起来像输入框里嵌了一颗正常按钮。
    -->
    <Style x:Key="Button.SearchClear" TargetType="Button" BasedOn="{StaticResource Button.Toolbar}">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="MinWidth" Value="18"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,5,0"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Inset}"/>
    </Style>

    <!--
        窗口按钮（FR-10.11）：最小化 / 最大化 / 关闭。

        不复用工具栏按钮：那套是 32px 见方 + 4px 圆角 + 悬停浅底，是"应用内控件"的语言；
        窗口键属于系统镶边，Windows 自己的规矩是 46×32 通栏、无圆角、悬停铺满整块。
        尺寸按系统走还有一个实际好处——用户对"右上角那一块能点"的肌肉记忆是像素级的，
        做大做小都会点空。

        图标尺寸固定 10px，不随字号放大（FONT-06）：这是键位，不是正文。
    -->
    <Style x:Key="Button.WindowControl" TargetType="Button">
        <Setter Property="Width" Value="{DynamicResource Size.WindowControl.Width}"/>
        <Setter Property="Height" Value="{DynamicResource Size.WindowControl.Height}"/>
        <Setter Property="MinWidth" Value="{DynamicResource Size.WindowControl.Width}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Icon}"/>
        <Setter Property="FontSize" Value="{DynamicResource Size.WindowControl}"/>
        <!-- 字形用 Display：见 Typography.xaml 的 Text.Glyph。
             窗口控制按钮是 10px 的细线，Ideal 下彩边最明显。 -->
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Inset}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Surface.Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Surface.Pressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        关闭键。与上面唯一的差别是悬停底色与前景色：
        Windows 的关闭红是用户唯一能凭颜色认出来的"这里会关掉窗口"，
        去掉它会让三个键长得一样，误点率上升。高对比度下该令牌退回系统强调色。
    -->
    <Style x:Key="Button.WindowClose" TargetType="Button" BasedOn="{StaticResource Button.WindowControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Window.CloseHover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Window.CloseHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        行内「更多操作」按钮（侧栏收藏 / 工作区行，FR-7 / FR-8）。

        18px 见方，与标签上的关闭键同尺寸：侧栏行高 28，再大的按钮会把行顶高。
        常态次级色、悬停才提亮——它常显在每一行上（右键之外唯一看得见的入口），
        用主色会跟行标题抢注意力；完全隐藏到悬停才现则会让用户以为"这行没有菜单"。
        不参与 Tab 遍历：侧栏一屏可能有二十行，各占一个焦点停靠点会把
        "从侧栏走到内容区"变成几十下 Tab；键盘入口是右键菜单键与 Shift+F10。
    -->
    <Style x:Key="Button.RowMenu" TargetType="Button">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource CornerRadius.Control}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Surface.Pressed}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
