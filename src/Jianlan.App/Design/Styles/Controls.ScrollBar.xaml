<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        滚动条（FR-5.1.1 / ui-guidelines §5 尺寸表）。

        这个文件补的是一处"规范写了、实现没做"的欠账：
        `Size.ScrollBar.Thickness = 10` 与三套主题里的 `Brush.Scroll.Thumb` /
        `Brush.Scroll.ThumbHover` 一直都存在，但项目里从来没有一处 ScrollBar 样式，
        于是全程用的是 WPF 默认的 Aero2 滚动条——17px 宽、两端带箭头按钮、
        浅灰配色，切到深色主题仍是浅灰。FR-5.1.1 要求"深色覆盖全部系统控件，
        含滚动条"，这一条一直是空的。

        三个决定：
        1. **无箭头按钮**。10px 的宽度里塞两颗 10×10 的箭头，每颗只剩 10×10 净面积，
           点起来比拖动还费劲，视觉上也是三截。只留 Track + Thumb，
           轨道上铺透明的 RepeatButton 保留"点一下翻一页"。
        2. **宽度取 token，不写字面值**。`Width` 也设 `MinWidth`：ScrollBar 的系统默认
           MinWidth 是 17，只改 Width 会被它顶回来，看起来"样式没生效"。
        3. **颜色全走 DynamicResource**。主题切换是替换 DesignTokens 内嵌的主题字典，
           用 StaticResource 的话换主题时颜色不会变——这正是这个文件存在的理由之一。

        隐式样式（无 x:Key）而不是具名样式：滚动条在 ScrollViewer / ListBox / ComboBox /
        TextBox 里都有，逐一挂 Style 要改十几处还会漏。放应用级资源里一次覆盖全部。
    -->

    <!-- 轨道上的翻页热区：透明、不参与 Tab、不抢焦点 -->
    <Style x:Key="ScrollBar.PageButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        滑块。Margin 四边各 2：留出轨道与滑块之间的空隙，挖出胶囊的形状。
        常态不透明到 100%（系统滚动条那种"半透明灰"在深色底上会糊成一片），
        悬停与拖动换成 token 里更亮的一档。
    -->
    <Style x:Key="ScrollBar.Thumb" TargetType="{x:Type Thumb}">
        <Setter Property="Background" Value="{DynamicResource Brush.Scroll.Thumb}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid Background="Transparent">
                        <Border x:Name="Bar"
                                Margin="2"
                                CornerRadius="{StaticResource CornerRadius.ScrollThumb}"
                                Background="{DynamicResource Brush.Scroll.Thumb}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background"
                                    Value="{DynamicResource Brush.Scroll.ThumbHover}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Background"
                                    Value="{DynamicResource Brush.Scroll.ThumbHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 纵向：IsDirectionReversed=True 是 WPF ScrollBar 的约定（往下滚 = 值变大） -->
    <ControlTemplate x:Key="ScrollBar.Vertical" TargetType="{x:Type ScrollBar}">
        <Grid Width="{TemplateBinding Width}" Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBar.PageButton}"
                                  Command="ScrollBar.PageUpCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <!-- MinHeight 20：轨道被内容拉得很长时，滑块会被压成一条 3px 的线，
                         胶囊圆角等于没写。20 是"还能看清是一块滑块"的下限。 -->
                    <Thumb Style="{StaticResource ScrollBar.Thumb}" MinHeight="20"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBar.PageButton}"
                                  Command="ScrollBar.PageDownCommand"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="ScrollBar.Horizontal" TargetType="{x:Type ScrollBar}">
        <Grid Height="{TemplateBinding Height}" Background="Transparent">
            <Track x:Name="PART_Track" Orientation="Horizontal">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBar.PageButton}"
                                  Command="ScrollBar.PageLeftCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollBar.Thumb}" MinWidth="20"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBar.PageButton}"
                                  Command="ScrollBar.PageRightCommand"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <!--
        隐式样式：应用级资源里的无键样式会自动应用到所有 ScrollBar，
        不需要逐个容器挂 Style（全项目十几处 ScrollViewer，逐个挂必漏）。

        MinWidth/MinHeight 必须一起设：ScrollBar 的系统默认最小宽度是 17，
        只设 Width 会被它顶回去。

        横向那一路用 Trigger 换模板并把 Width 放回 Auto、Height 设成 10。
        不换的话横向滚动条会被压成 10px 宽的一条竖线。
    -->
    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="{DynamicResource Size.ScrollBar.Thickness}"/>
        <Setter Property="MinWidth" Value="{DynamicResource Size.ScrollBar.Thickness}"/>
        <Setter Property="Template" Value="{StaticResource ScrollBar.Vertical}"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="{DynamicResource Size.ScrollBar.Thickness}"/>
                <Setter Property="MinHeight" Value="{DynamicResource Size.ScrollBar.Thickness}"/>
                <Setter Property="Template" Value="{StaticResource ScrollBar.Horizontal}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
