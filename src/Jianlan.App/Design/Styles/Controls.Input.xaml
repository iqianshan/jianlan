<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        设置页用到的输入控件。之所以自己写模板：WPF 默认模板在深色主题下会露出
        系统白色的下拉框与复选框，和我们的配色完全冲突（FR-5.1.1 要求深色覆盖全部控件）。
        所有颜色走 DynamicResource，切换主题即时生效。
    -->

    <Style x:Key="ComboBoxItem.Default" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="8,6,8,6"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            CornerRadius="{StaticResource CornerRadius.Control}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Surface.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Surface.Selected}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnSelected}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ComboBox.Default" TargetType="ComboBox">
        <Setter Property="Height" Value="{DynamicResource Size.Row.Comfortable}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Ring}"/>
        <Setter Property="MinWidth" Value="160"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource ComboBoxItem.Default}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Bd"
                                Background="{DynamicResource Brush.Surface.Content}"
                                BorderBrush="{DynamicResource Brush.Border.Hairline}"
                                BorderThickness="{DynamicResource BorderThickness.Hairline}"
                                CornerRadius="{StaticResource CornerRadius.Control}"/>

                        <ContentPresenter Margin="{DynamicResource Size.ComboContent.Margin}"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>

                        <TextBlock Margin="{DynamicResource Size.ComboArrow.Margin}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Text="▾"/>

                        <!-- 整块可点击：覆盖一个透明 ToggleButton，避免自定义箭头点不开 -->
                        <ToggleButton Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                          RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Popup AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               PopupAnimation="Fade">
                            <Border Margin="0,4,0,0"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="320"
                                    Background="{DynamicResource Brush.Surface.Floating}"
                                    BorderBrush="{DynamicResource Brush.Border.Strong}"
                                    BorderThickness="{DynamicResource BorderThickness.Hairline}"
                                    CornerRadius="{StaticResource CornerRadius.Menu}"
                                    Padding="4">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CheckBox.Default" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <!-- 自定义模板没有焦点反馈，不补的话 Tab 到复选框时屏幕上看不出变化（FR-10.7） -->
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Inset}"/>
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box"
                                Width="16"
                                Height="16"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Brush.Surface.Content}"
                                BorderBrush="{DynamicResource Brush.Border.Strong}"
                                BorderThickness="{DynamicResource BorderThickness.Hairline}"
                                CornerRadius="3">
                            <TextBlock x:Name="Mark"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{DynamicResource Brush.Accent.OnFill}"
                                       Text="✓"
                                       Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Accent.Default}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Default}"/>
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 设置区块标题 -->
    <Style x:Key="Text.SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Subtitle}">
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!--
        设置页内的分组标题（"主题与字体""确认与保护"这类）。

        与页标题（Text.Subtitle，15px）差一级：这里降到正文字号、次级色、加粗。
        用色相与字重而不是再放大字号——一页里出现两个 15px 标题时，
        读的人分不清哪个是页面、哪个是段落。
    -->
    <!--
        分组标题（v3）。原来是"次要色 + 加粗"，和下面的字段标签几乎同色同号，
        整页读下来分不出哪几行是一组——浅色、深色都一样。

        底色方案先被否掉了：浅色主题里 Surface.Hover(#F4F4F7) 与 Surface.Window(#F7F7F9)
        只差 3/255，色块根本看不见；深色也只差一档，不值当作一种"分段手段"。

        所以改成用线切段：Border 顶上一条 hairline，文字提到主文字色。
        线不抢眼，但在两种主题下都能把"段"和"项"分成两级。
        间距（上 14 / 线下 10 / 下 4）比文字本身更重要——它是分段感的主要来源。
    -->
    <!-- 分组标题：标题在上、1px 细线在下，线只负责"切段"，不参与分级。
         线放在标题下方而不是上方，是因为读的顺序是"先看到组名，再看到线，
         再看到这一组的内容"——线在标题上面时，用户先撞到的是一条线，
         标题反而像是上一组的结尾。 -->
    <Style x:Key="Heading.Group" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Hairline}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="0,0,0,8"/>
        <Setter Property="Margin" Value="0,14,0,10"/>
    </Style>

    <Style x:Key="Text.GroupTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="FontWeight" Value="{StaticResource Font.Weight.Emphasis}"/>
    </Style>

    <!-- 设置项标签：定宽，让右侧控件左边缘对齐。
         宽度必须随字号缩放（FontMetrics.FieldLabelWidth）：写死 120 时 24pt 下
         "界面语言"被截成"界面…"（AC-06 走查发现）。 -->
    <Style x:Key="Text.FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="Width" Value="{DynamicResource Size.FieldLabel.Width}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Text.FieldHint" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
        <Setter Property="Margin" Value="{DynamicResource Size.FieldHint.Margin}"/>
        <!-- 英文提示比中文长 30–50%，单行必然被省略号截断（AC-11）。
             换行而不是加宽：提示本来就是补充信息，两行比横向撑破布局更可接受。 -->
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextTrimming" Value="None"/>
    </Style>

</ResourceDictionary>
