<UserControl x:Class="Jianlan.App.Views.PreviewPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Jianlan.App.Localization"
             AutomationProperties.Name="{loc:Tr Key=A11y.Preview}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed">

    <!--
        预览窗格（FR-9.1）。窗口右侧一栏，反映**活动窗格**的选中项——
        分屏时两个窗格共用一个预览，因为预览回答的是"我此刻在看什么"，
        而不是"每个窗格各有一个预览"。

        四层内容共用同一个格子（空态 / 多选 / 图片 / 文本 / 说明），
        靠 Visibility 切换而不是换模板：换模板要重建可视化树，
        每次上下键选中都会闪一下。
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- 说明态里的「立即预览」按钮。只在延后触发（网络/可移动设备）时出现 -->
        <Style x:Key="Button.PreviewRetry" TargetType="Button" BasedOn="{StaticResource Button.NavCommand}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>

        <!-- 操作行的三颗按钮（FR-9.1.5）。
             不基于 Button.NavCommand：那个有最小宽度与描边，三颗并排会像三个工具按钮，
             而这行是"对当前这份文件的动作"，视觉上应当比标题轻一档。 -->
        <Style x:Key="Button.PreviewAction" TargetType="Button" BasedOn="{StaticResource Button.Link}">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource Brush.Surface.Sidebar}"
            BorderBrush="{DynamicResource Brush.Border.Hairline}"
            BorderThickness="1,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题块：文件名 + 类型/大小/日期 + 完整路径，右下三颗操作（FR-9.1.5）。
                 路径折两行封顶：再长就该看提示了，不能把这栏撑成一段说明文。 -->
            <Grid Grid.Row="0" Margin="16,14,16,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题行 + 关闭（FR-9.1.5 的第二半）。
                     关闭按钮放在标题行右侧，而不是内容区里：它是"这一栏"的开关，
                     与 Alt+P 同义，位置不该随预览内容形态（图/文/说明）上下浮动。 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               Style="{StaticResource Text.Base}"
                               FontWeight="{DynamicResource Font.Weight.Emphasis}"
                               Text="{Binding TitleText}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"/>

                    <Button Grid.Column="1"
                            x:Name="CloseButton"
                            Style="{StaticResource Button.Header}"
                            Width="22" Height="22" Padding="0"
                            HorizontalContentAlignment="Center"
                            ToolTip="{loc:Tr Key=Preview.Close.Tip}"
                            AutomationProperties.Name="{loc:Tr Key=Preview.Close.Tip}"
                            Click="OnCloseClick">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10"
                                   TextOptions.TextFormattingMode="Display"
                                   Text="&#xE711;"/>
                    </Button>
                </Grid>

                <TextBlock Grid.Row="1"
                           Margin="0,4,0,0"
                           Style="{StaticResource Text.Caption}"
                           Text="{Binding MetaText}"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}"/>

                <TextBlock Grid.Row="2"
                           Margin="0,2,0,0"
                           Style="{StaticResource Text.Caption}"
                           Text="{Binding PathText}"
                           TextWrapping="Wrap"
                           MaxHeight="32"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding PathText}"
                           Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}"/>

                <!-- 操作行（FR-9.1.5）：只在单选时出现。多选时预览显示的是汇总，
                     没有唯一目标可打开/删除——给三颗按钮反而让人以为能批量操作。
                     左移 6px 抵掉按钮自身的内边距，让"打开"与上面的文件名左对齐。 -->
                <StackPanel Grid.Row="3"
                            Margin="-6,6,0,0"
                            Orientation="Horizontal"
                            Visibility="{Binding CanAct, Converter={StaticResource BoolToVisibility}}">
                    <Button x:Name="OpenButton"
                            Style="{StaticResource Button.PreviewAction}"
                            Content="{loc:Tr Key=Preview.Action.Open}"
                            ToolTip="{loc:Tr Key=Preview.Action.Open.Tip}"
                            AutomationProperties.Name="{loc:Tr Key=Preview.Action.Open.Tip}"
                            Click="OnOpenClick"/>
                    <Button x:Name="CopyPathButton"
                            Style="{StaticResource Button.PreviewAction}"
                            Content="{loc:Tr Key=Preview.Action.CopyPath}"
                            ToolTip="{loc:Tr Key=Preview.Action.CopyPath.Tip}"
                            AutomationProperties.Name="{loc:Tr Key=Preview.Action.CopyPath.Tip}"
                            Click="OnCopyPathClick"/>
                    <Button x:Name="DeleteButton"
                            Style="{StaticResource Button.PreviewAction}"
                            Content="{loc:Tr Key=Preview.Action.Delete}"
                            ToolTip="{loc:Tr Key=Preview.Action.Delete.Tip}"
                            AutomationProperties.Name="{loc:Tr Key=Preview.Action.Delete.Tip}"
                            Click="OnDeleteClick"/>
                </StackPanel>
            </Grid>

            <!-- 内容区 -->
            <Grid Grid.Row="1" Margin="16,0,16,0">
                <!-- 空态：一句提示居中偏上，不做垂直居中——居中会让整个窗格像一块空白面板 -->
                <TextBlock VerticalAlignment="Top"
                           Margin="0,8,0,0"
                           Style="{StaticResource Text.Caption}"
                           Text="{loc:Tr Key=Preview.Empty}"
                           TextWrapping="Wrap"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>

                <!-- 多选（FR-9.1.6）不在这里重复一遍：标题块已经写了"已选中 N 项 / 共 X"，
                     再画一次就是同一句话上下各一份。这里留空，让"没有单个文件可看"自己说明问题。 -->

                <!-- 图片。解码时已按窗格宽度限幅，这里只管等比铺满 -->
                <Image x:Name="PreviewImage"
                       Source="{Binding Image}"
                       Stretch="Uniform"
                       StretchDirection="DownOnly"
                       VerticalAlignment="Top"
                       HorizontalAlignment="Stretch"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibility}}"/>

                <!-- 文本。只读 TextBox 而不是 TextBlock：用户要能选中、复制其中一段，
                     这在"看一眼配置文件"的场景里比什么都实用。
                     它是预览窗格里唯一能用键盘操作的东西（方向键/PageUp 滚动、Ctrl+C 复制），
                     所以给一条内描边焦点环——光标在这里不够醒目。 -->
                <TextBox Text="{Binding TextContent, Mode=OneWay}"
                         IsReadOnly="True"
                         IsReadOnlyCaretVisible="True"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="NoWrap"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="0"
                         FontFamily="{DynamicResource Font.Family.Mono}"
                         FontSize="{DynamicResource Font.Size.Caption}"
                         Foreground="{DynamicResource Brush.Text.Primary}"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalAlignment="Stretch"
                         FocusVisualStyle="{StaticResource FocusVisual.Inset}"
                         AutomationProperties.Name="{loc:Tr Key=A11y.PreviewText}"
                         Visibility="{Binding HasText, Converter={StaticResource BoolToVisibility}}"/>

                <!-- 系统预览处理器（FR-9.1.3）。它画在一个真实的子窗口里，
                     会把上面这些 WPF 内容整块盖住——所以处理器模式下那几层都是 Collapsed，
                     这里不与它们抢位置。 -->
                <Grid x:Name="HandlerLayer"
                      Background="Transparent"
                      Visibility="{Binding HasHandler, Converter={StaticResource BoolToVisibility}}"/>

                <!-- 取不到内容：图标 + 一句说明（FR-9.1.4）。不报错、不弹窗。
                     图标按 32px 原生尺寸画：系统图标只有 16/32 两档，硬放大只会得到一团白块。 -->
                <StackPanel VerticalAlignment="Top"
                            Margin="0,8,0,0"
                            Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}">
                    <Image Width="32" Height="32"
                           HorizontalAlignment="Left"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="{Binding Icon}"/>
                    <TextBlock Margin="0,12,0,0"
                               Style="{StaticResource Text.Caption}"
                               Text="{Binding NoteText}"
                               TextWrapping="Wrap"/>
                    <Button Style="{StaticResource Button.PreviewRetry}"
                            Content="{loc:Tr Key=Preview.DeferredAction}"
                            Click="OnRetryClick"
                            Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Grid>

            <!-- 脚注：截断提示这类补充说明，没有内容时不占高度 -->
            <TextBlock Grid.Row="2"
                       Margin="16,8,16,12"
                       Text="{Binding FooterText}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                        <Setter Property="TextWrapping" Value="Wrap"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FooterText}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Border>
</UserControl>
