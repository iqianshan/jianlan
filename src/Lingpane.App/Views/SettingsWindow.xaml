<Window x:Class="Lingpane.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Lingpane.App.Localization"
        Title="{loc:Tr Key=Toolbar.Settings}"
        Width="640" Height="660"
        MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Surface.Window}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题 -->
        <Border Grid.Row="0"
                Padding="{StaticResource Padding.Dialog}"
                Background="{DynamicResource Brush.Surface.Window}"
                BorderBrush="{DynamicResource Brush.Border.Hairline}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Title}" Text="{loc:Tr Key=Toolbar.Settings}"/>
                <!-- 用可换行版本：24pt 下这句副标题比窗口宽，单行会被省略号截断（AC-06） -->
                <TextBlock Margin="0,4,0,0"
                           Style="{StaticResource Text.Caption.Wrap}"
                           Text="{loc:Tr Key=Settings.Subtitle}"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      Padding="{StaticResource Padding.Dialog}"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ══ 通用 ══ -->
                <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{loc:Tr Key=Settings.General}"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Style="{StaticResource Text.FieldLabel}" Text="{loc:Tr Key=Settings.Language}"/>
                    <ComboBox x:Name="LanguageCombo"
                              Style="{StaticResource ComboBox.Default}"
                              SelectionChanged="OnLanguageChanged">
                        <ComboBoxItem Content="{loc:Tr Key=Settings.Language.Auto}"/>
                        <ComboBoxItem Content="{loc:Tr Key=Settings.Language.Chinese}"/>
                        <ComboBoxItem Content="{loc:Tr Key=Settings.Language.English}"/>
                    </ComboBox>
                </StackPanel>

                <!-- ══ 外观 ══ -->
                <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{loc:Tr Key=Settings.Section.Appearance}"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Style="{StaticResource Text.FieldLabel}" Text="{loc:Tr Key=Settings.Appearance.Theme}"/>
                    <ComboBox x:Name="ThemeCombo"
                              Style="{StaticResource ComboBox.Default}"
                              SelectionChanged="OnThemeChanged">
                        <ComboBoxItem Content="{loc:Tr Key=Settings.Theme.FollowSystem}"/>
                        <ComboBoxItem Content="{loc:Tr Key=Settings.Theme.Light}"/>
                        <ComboBoxItem Content="{loc:Tr Key=Settings.Theme.Dark}"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Style="{StaticResource Text.FieldLabel}" Text="{loc:Tr Key=Settings.Appearance.Font}"/>
                    <ComboBox x:Name="FontCombo"
                              Width="300"
                              Style="{StaticResource ComboBox.Default}"
                              SelectionChanged="OnFontChanged"
                              ToolTip="{loc:Tr Key=Settings.Appearance.Font.Tip}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <!-- 用该字体自身渲染名称作为预览（FR-5.1.5） -->
                                <TextBlock FontFamily="{Binding Family}"
                                           FontSize="14"
                                           Text="{Binding DisplayName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <TextBlock x:Name="FontHint"
                           Style="{StaticResource Text.FieldHint}"
                           Text="{loc:Tr Key=Settings.Appearance.Font.Hint}"/>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Style="{StaticResource Text.FieldLabel}" Text="{loc:Tr Key=Settings.Appearance.FontSize}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Button.Toolbar}"
                                Content="−"
                                Click="OnFontSizeDown"
                                ToolTip="{loc:Tr Key=Settings.Appearance.FontSize.Decrease}"/>
                        <TextBlock x:Name="FontSizeText"
                                   Width="72"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   Style="{StaticResource Text.Base}"
                                   Text="{loc:Tr Key=Settings.Appearance.FontSize.FollowSystem}"/>
                        <Button Style="{StaticResource Button.Toolbar}"
                                Content="+"
                                Click="OnFontSizeUp"
                                ToolTip="{loc:Tr Key=Settings.Appearance.FontSize.Increase}"/>
                        <CheckBox x:Name="FollowSystemFontCheck"
                                  Margin="12,0,0,0"
                                  Style="{StaticResource CheckBox.Default}"
                                  Content="{loc:Tr Key=Settings.Appearance.FontSize.FollowSystem}"
                                  VerticalAlignment="Center"
                                  Checked="OnFollowSystemFontChanged"
                                  Unchecked="OnFollowSystemFontChanged"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,12">
                    <TextBlock Style="{StaticResource Text.FieldLabel}" Text="{loc:Tr Key=Settings.Appearance.Density}"/>
                    <ComboBox x:Name="DensityCombo"
                              Style="{StaticResource ComboBox.Default}"
                              SelectionChanged="OnDensityChanged">
                        <ComboBoxItem Content="{loc:Tr Key=Settings.Appearance.Density.Comfortable}"/>
                        <ComboBoxItem Content="{loc:Tr Key=Settings.Appearance.Density.Compact}"/>
                    </ComboBox>
                </StackPanel>

                <CheckBox x:Name="ShowNavCheck"
                          Margin="0,0,0,10"
                          Style="{StaticResource CheckBox.Default}"
                          Content="{loc:Tr Key=Settings.Appearance.ShowNav}"
                          Checked="OnShowNavChanged"
                          Unchecked="OnShowNavChanged"/>

                <CheckBox x:Name="ShowStatusCheck"
                          Margin="0,0,0,16"
                          Style="{StaticResource CheckBox.Default}"
                          Content="{loc:Tr Key=Settings.Appearance.ShowStatus}"
                          Checked="OnShowStatusChanged"
                          Unchecked="OnShowStatusChanged"/>

                <!-- ══ 行为 ══ -->
                <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{loc:Tr Key=Settings.Section.Behavior}"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Style="{StaticResource Text.FieldLabel}" Text="{loc:Tr Key=Settings.Behavior.DefaultView}"/>
                    <ComboBox x:Name="ViewCombo"
                              Style="{StaticResource ComboBox.Default}"
                              SelectionChanged="OnDefaultViewChanged">
                        <ComboBoxItem Content="{loc:Tr Key=Settings.Behavior.View.Details}"/>
                        <ComboBoxItem Content="{loc:Tr Key=Settings.Behavior.View.List}"/>
                    </ComboBox>
                </StackPanel>
                <TextBlock Style="{StaticResource Text.FieldHint}" Text="{loc:Tr Key=Settings.Behavior.NextLaunch}"/>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,4">
                    <TextBlock Style="{StaticResource Text.FieldLabel}" Text="{loc:Tr Key=Settings.Behavior.DefaultSort}"/>
                    <ComboBox x:Name="SortCombo"
                              Style="{StaticResource ComboBox.Default}"
                              SelectionChanged="OnDefaultSortChanged">
                        <ComboBoxItem Content="{loc:Tr Key=Column.Name}"/>
                        <ComboBoxItem Content="{loc:Tr Key=Column.DateModified}"/>
                        <ComboBoxItem Content="{loc:Tr Key=Column.Type}"/>
                        <ComboBoxItem Content="{loc:Tr Key=Column.Size}"/>
                    </ComboBox>
                </StackPanel>
                <TextBlock Style="{StaticResource Text.FieldHint}" Text="{loc:Tr Key=Settings.Behavior.SortHint}"/>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,12">
                    <TextBlock Style="{StaticResource Text.FieldLabel}" Text="{loc:Tr Key=Settings.Behavior.SortMode}"/>
                    <CheckBox x:Name="DescendingCheck"
                              Margin="0,0,20,0"
                              VerticalAlignment="Center"
                              Style="{StaticResource CheckBox.Default}"
                              Content="{loc:Tr Key=Sort.Descending}"
                              Checked="OnSortOptionChanged"
                              Unchecked="OnSortOptionChanged"/>
                    <CheckBox x:Name="FoldersFirstCheck"
                              VerticalAlignment="Center"
                              Style="{StaticResource CheckBox.Default}"
                              Content="{loc:Tr Key=Settings.Behavior.FoldersFirst}"
                              Checked="OnSortOptionChanged"
                              Unchecked="OnSortOptionChanged"/>
                </StackPanel>

                <CheckBox x:Name="ShowHiddenCheck"
                          Margin="0,0,0,10"
                          Style="{StaticResource CheckBox.Default}"
                          Content="{loc:Tr Key=Settings.Behavior.ShowHidden}"
                          Checked="OnShowHiddenChanged"
                          Unchecked="OnShowHiddenChanged"/>

                <CheckBox x:Name="ShowExtensionsCheck"
                          Margin="0,0,0,10"
                          Style="{StaticResource CheckBox.Default}"
                          Content="{loc:Tr Key=Settings.Behavior.ShowExtensions}"
                          Checked="OnShowExtensionsChanged"
                          Unchecked="OnShowExtensionsChanged"/>

                <CheckBox x:Name="ConfirmDeleteCheck"
                          Margin="0,0,0,16"
                          Style="{StaticResource CheckBox.Default}"
                          Content="{loc:Tr Key=Settings.Behavior.ConfirmDelete}"
                          Checked="OnConfirmDeleteChanged"
                          Unchecked="OnConfirmDeleteChanged"/>

                <!-- ══ 隐私 ══ -->
                <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{loc:Tr Key=Settings.Section.Privacy}"/>

                <CheckBox x:Name="RememberPathCheck"
                          Margin="0,0,0,4"
                          Style="{StaticResource CheckBox.Default}"
                          Content="{loc:Tr Key=Settings.Privacy.RememberPath}"
                          Checked="OnRememberPathChanged"
                          Unchecked="OnRememberPathChanged"/>
                <TextBlock Style="{StaticResource Text.FieldHint}"
                           Text="{loc:Tr Key=Settings.Privacy.RememberPath.Hint}"/>

                <Button Margin="0,12,0,16"
                        HorizontalAlignment="Left"
                        Style="{StaticResource Button.Toolbar}"
                        Content="{loc:Tr Key=Settings.Privacy.ClearPath}"
                        Click="OnClearRecentPath"/>

                <!-- ══ 关于 ══ -->
                <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{loc:Tr Key=Settings.Section.About}"/>
                <TextBlock x:Name="AboutText"
                           Style="{StaticResource Text.Caption.Wrap}"
                           Text=""/>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部操作 -->
        <Border Grid.Row="2"
                Padding="{StaticResource Padding.Dialog}"
                Background="{DynamicResource Brush.Surface.Window}"
                BorderBrush="{DynamicResource Brush.Border.Hairline}"
                BorderThickness="0,1,0,0">
            <!--
                三个按钮不放在同一行的四个自动列里：列宽都是 Auto，内容比窗口宽时
                不会压缩也不会换行，只会把最右边的「关闭」推出窗口（英文 24pt 实测被切）。
                左侧两个次要操作改用 WrapPanel，挤不下时折成两行。
            -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Toolbar}"
                            Content="{loc:Tr Key=Settings.ResetAppearance}"
                            Click="OnResetAppearance"
                            ToolTip="{loc:Tr Key=Settings.ResetAppearance.Tip}"/>
                    <Button Style="{StaticResource Button.Toolbar}"
                            Content="{loc:Tr Key=Settings.OpenDataDir}"
                            Click="OnOpenDataDir"/>
                </WrapPanel>
                <Button Grid.Column="1"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource Button.Toolbar}"
                        Content="{loc:Tr Key=Common.Close}"
                        Click="OnClose"/>
            </Grid>
        </Border>
    </Grid>
</Window>
