<Window x:Class="Lingpane.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="640" Height="660"
        MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Surface.Window}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题 -->
        <Border Grid.Row="0"
                Padding="{StaticResource Padding.Dialog}"
                Background="{DynamicResource Brush.Surface.Window}"
                BorderBrush="{DynamicResource Brush.Border.Hairline}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Title}" Text="设置"/>
                <TextBlock Margin="0,4,0,0"
                           Style="{StaticResource Text.Caption}"
                           Text="修改即时生效并保存；标注「下次启动」的项除外。"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      Padding="{StaticResource Padding.Dialog}"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ══ 外观 ══ -->
                <TextBlock Style="{StaticResource Text.SectionTitle}" Text="外观"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Style="{StaticResource Text.FieldLabel}" Text="主题"/>
                    <ComboBox x:Name="ThemeCombo"
                              Style="{StaticResource ComboBox.Default}"
                              SelectionChanged="OnThemeChanged">
                        <ComboBoxItem Content="跟随系统"/>
                        <ComboBoxItem Content="浅色"/>
                        <ComboBoxItem Content="深色"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Style="{StaticResource Text.FieldLabel}" Text="界面字体"/>
                    <ComboBox x:Name="FontCombo"
                              Width="300"
                              Style="{StaticResource ComboBox.Default}"
                              SelectionChanged="OnFontChanged"
                              ToolTip="只列出系统已安装字体；程序不自带字体文件">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <!-- 用该字体自身渲染名称作为预览（FR-5.1.5） -->
                                <TextBlock FontFamily="{Binding Family}"
                                           FontSize="14"
                                           Text="{Binding DisplayName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <TextBlock x:Name="FontHint"
                           Style="{StaticResource Text.FieldHint}"
                           Text="仅系统已安装字体，不支持导入"/>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Style="{StaticResource Text.FieldLabel}" Text="字号"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Button.Toolbar}"
                                Content="−"
                                Click="OnFontSizeDown"
                                ToolTip="减小 1pt"/>
                        <TextBlock x:Name="FontSizeText"
                                   Width="72"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   Style="{StaticResource Text.Base}"
                                   Text="跟随系统"/>
                        <Button Style="{StaticResource Button.Toolbar}"
                                Content="+"
                                Click="OnFontSizeUp"
                                ToolTip="增大 1pt"/>
                        <CheckBox x:Name="FollowSystemFontCheck"
                                  Margin="12,0,0,0"
                                  Style="{StaticResource CheckBox.Default}"
                                  Content="跟随系统"
                                  VerticalAlignment="Center"
                                  Checked="OnFollowSystemFontChanged"
                                  Unchecked="OnFollowSystemFontChanged"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,12">
                    <TextBlock Style="{StaticResource Text.FieldLabel}" Text="界面密度"/>
                    <ComboBox x:Name="DensityCombo"
                              Style="{StaticResource ComboBox.Default}"
                              SelectionChanged="OnDensityChanged">
                        <ComboBoxItem Content="舒适"/>
                        <ComboBoxItem Content="紧凑"/>
                    </ComboBox>
                </StackPanel>

                <CheckBox x:Name="ShowNavCheck"
                          Margin="0,0,0,10"
                          Style="{StaticResource CheckBox.Default}"
                          Content="显示左侧导航栏"
                          Checked="OnShowNavChanged"
                          Unchecked="OnShowNavChanged"/>

                <CheckBox x:Name="ShowStatusCheck"
                          Margin="0,0,0,16"
                          Style="{StaticResource CheckBox.Default}"
                          Content="显示底部状态栏"
                          Checked="OnShowStatusChanged"
                          Unchecked="OnShowStatusChanged"/>

                <!-- ══ 行为 ══ -->
                <TextBlock Style="{StaticResource Text.SectionTitle}" Text="行为"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Style="{StaticResource Text.FieldLabel}" Text="默认视图"/>
                    <ComboBox x:Name="ViewCombo"
                              Style="{StaticResource ComboBox.Default}"
                              SelectionChanged="OnDefaultViewChanged">
                        <ComboBoxItem Content="详细信息"/>
                        <ComboBoxItem Content="列表"/>
                    </ComboBox>
                </StackPanel>
                <TextBlock Style="{StaticResource Text.FieldHint}" Text="下次启动时生效"/>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,4">
                    <TextBlock Style="{StaticResource Text.FieldLabel}" Text="默认排序"/>
                    <ComboBox x:Name="SortCombo"
                              Style="{StaticResource ComboBox.Default}"
                              SelectionChanged="OnDefaultSortChanged">
                        <ComboBoxItem Content="名称"/>
                        <ComboBoxItem Content="修改日期"/>
                        <ComboBoxItem Content="类型"/>
                        <ComboBoxItem Content="大小"/>
                    </ComboBox>
                </StackPanel>
                <TextBlock Style="{StaticResource Text.FieldHint}" Text="下次启动时生效；列头点击只在本次会话内有效"/>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,12">
                    <TextBlock Style="{StaticResource Text.FieldLabel}" Text="排序方式"/>
                    <CheckBox x:Name="DescendingCheck"
                              Margin="0,0,20,0"
                              VerticalAlignment="Center"
                              Style="{StaticResource CheckBox.Default}"
                              Content="降序"
                              Checked="OnSortOptionChanged"
                              Unchecked="OnSortOptionChanged"/>
                    <CheckBox x:Name="FoldersFirstCheck"
                              VerticalAlignment="Center"
                              Style="{StaticResource CheckBox.Default}"
                              Content="文件夹优先"
                              Checked="OnSortOptionChanged"
                              Unchecked="OnSortOptionChanged"/>
                </StackPanel>

                <CheckBox x:Name="ShowHiddenCheck"
                          Margin="0,0,0,10"
                          Style="{StaticResource CheckBox.Default}"
                          Content="显示隐藏文件"
                          Checked="OnShowHiddenChanged"
                          Unchecked="OnShowHiddenChanged"/>

                <CheckBox x:Name="ShowExtensionsCheck"
                          Margin="0,0,0,10"
                          Style="{StaticResource CheckBox.Default}"
                          Content="显示文件扩展名"
                          Checked="OnShowExtensionsChanged"
                          Unchecked="OnShowExtensionsChanged"/>

                <CheckBox x:Name="ConfirmDeleteCheck"
                          Margin="0,0,0,16"
                          Style="{StaticResource CheckBox.Default}"
                          Content="删除前确认（文件操作在 M1 批 3 接入）"
                          Checked="OnConfirmDeleteChanged"
                          Unchecked="OnConfirmDeleteChanged"/>

                <!-- ══ 隐私 ══ -->
                <TextBlock Style="{StaticResource Text.SectionTitle}" Text="隐私"/>

                <CheckBox x:Name="RememberPathCheck"
                          Margin="0,0,0,4"
                          Style="{StaticResource CheckBox.Default}"
                          Content="记住上次打开的目录"
                          Checked="OnRememberPathChanged"
                          Unchecked="OnRememberPathChanged"/>
                <TextBlock Style="{StaticResource Text.FieldHint}"
                           Text="只保存在本机 settings.json，不上传；关闭后下次启动回到「文档」"/>

                <Button Margin="0,12,0,16"
                        HorizontalAlignment="Left"
                        Style="{StaticResource Button.Toolbar}"
                        Content="清空已记录的路径"
                        Click="OnClearRecentPath"/>

                <!-- ══ 关于 ══ -->
                <TextBlock Style="{StaticResource Text.SectionTitle}" Text="关于"/>
                <TextBlock x:Name="AboutText"
                           Style="{StaticResource Text.Caption.Wrap}"
                           Text=""/>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部操作 -->
        <Border Grid.Row="2"
                Padding="{StaticResource Padding.Dialog}"
                Background="{DynamicResource Brush.Surface.Window}"
                BorderBrush="{DynamicResource Brush.Border.Hairline}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource Button.Toolbar}"
                        Content="重置外观"
                        Click="OnResetAppearance"
                        ToolTip="字体与字号恢复系统默认"/>
                <Button Grid.Column="1"
                        Style="{StaticResource Button.Toolbar}"
                        Content="打开数据目录"
                        Click="OnOpenDataDir"/>
                <Button Grid.Column="3"
                        Style="{StaticResource Button.Toolbar}"
                        Content="关闭"
                        Click="OnClose"/>
            </Grid>
        </Border>
    </Grid>
</Window>
