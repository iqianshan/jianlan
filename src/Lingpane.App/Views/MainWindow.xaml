<Window x:Class="Lingpane.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Lingpane.App.Views"
        Title="{Binding TitleText}"
        Height="720" Width="1100"
        MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Surface.Window}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed">

    <!--
        窗口壳。只负责"窗口"这一层：标签栏、导航栏、快捷键、热键、设置、会话。
        浏览区（工具栏 + 地址栏 + 列头 + 列表 + 状态栏）整体下沉到 PaneView，
        原因见 PaneView.xaml.cs 的注释。

        标签栏（FR-2）横跨整窗：标签是窗口级的，不属于某个窗格；
        下面的浏览区只有一份，切标签 = 把它重新绑到另一份视图模型。
        双窗格（FR-3）接入时，Pane 会换成能容纳两个 pane 的 Grid。
    -->

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavColumn" Width="Auto"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <!-- 标签栏 -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <!-- 与窗格状态栏等高的占位：让导航栏底部的分隔线与状态栏上边框连成一条 -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="3"
                Background="{DynamicResource Brush.Surface.Window}"
                BorderBrush="{DynamicResource Brush.Border.Hairline}"
                BorderThickness="0,0,0,1">
            <views:TabStrip x:Name="TabBar"/>
        </Border>

        <!-- 常用目录（FR-1.1）。
             宽度取内容宽度并夹在 184–320 之间（AC-06 走查修正）：
             原来写死 184，英文 24pt 下 "Documents / Downloads" 比栏宽还长，
             被 ListBox 直接切掉、连省略号都没有。改为随内容增长，
             中文与常规字号下内容不足 184，宽度与原来完全一致。 -->
        <ListBox x:Name="QuickAccessList"
                 Grid.Column="0"
                 Grid.Row="1"
                 Width="Auto"
                 MinWidth="{DynamicResource Size.Nav.Width.Default}"
                 MaxWidth="{DynamicResource Size.Nav.Width.Max}"
                 Style="{StaticResource Nav.Surface}"
                 ItemsSource="{Binding QuickAccess}"
                 SelectionChanged="OnQuickAccessSelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!-- 用两列 Grid 而不是横向 StackPanel：StackPanel 横向测量时给子项无限宽，
                         TextTrimming 永远不触发，文字只会被硬裁。 -->
                    <Grid Margin="{StaticResource Padding.NavItem}"
                          VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Margin="0,0,8,0"
                                   Style="{StaticResource Text.Glyph}"
                                   Text="{Binding Glyph}"/>
                        <TextBlock Grid.Column="1"
                                   Style="{StaticResource Text.Nav}"
                                   Text="{Binding Name}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Column="1" Grid.Row="1" Grid.RowSpan="2" Background="{DynamicResource Brush.Border.Hairline}"/>

        <!-- 导航栏底部的状态栏等高占位（见上面 RowDefinitions 的注释） -->
        <Border x:Name="NavStatusSpacer"
                Grid.Column="0" Grid.Row="2"
                Height="{DynamicResource Size.StatusBar.Height}"
                Background="{DynamicResource Brush.Surface.Window}"
                BorderBrush="{DynamicResource Brush.Border.Hairline}"
                BorderThickness="0,1,0,0"/>

        <!-- 浏览区。宿主注入视图模型，见 MainWindow 构造函数。 -->
        <views:PaneView x:Name="Pane" Grid.Column="2" Grid.Row="1" Grid.RowSpan="2"/>
    </Grid>
</Window>
