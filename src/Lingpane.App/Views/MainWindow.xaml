<Window x:Class="Lingpane.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Lingpane.App.Views"
        xmlns:vm="clr-namespace:Lingpane.App.ViewModels"
        xmlns:loc="clr-namespace:Lingpane.App.Localization"
        Title="{Binding TitleText}"
        Height="720" Width="1100"
        MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Surface.Window}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed">

    <Window.Resources>
        <!-- 分区菜单互斥、工作区行的"启动项"小点都靠它（HomeView 有自己的同名资源，
             两个 UserControl/Window 的 Resources 不共享） -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- 收藏外观预设子菜单里的条目（FR-7.5）。用 EventSetter 挂同一个处理器：
             子项由预设表生成，逐个写 Click 既重复又容易漏。
             MinWidth 压到 140：主菜单项是 200 宽（要放键位提示），色块行不需要那么宽。 -->
        <Style x:Key="Bookmark.PresetItem" TargetType="MenuItem" BasedOn="{StaticResource MenuItem.Default}">
            <Setter Property="MinWidth" Value="140"/>
            <EventSetter Event="Click" Handler="OnBookmarkPresetPicked"/>
        </Style>

        <!--
            导航栏的行模板（FR-1.2 + FR-7.3）。五种行共处一条 ListBox，靠类型挑模板：
            系统节点 / 分区标题 / 空态提示 / 收藏分组 / 收藏项。
            用一条列表而不是"快速访问 + 收藏两棵树"，是为了只有一套选中态——
            两套的话点了收藏、快速访问那边还亮着，得再写一处手动互斥。
        -->

        <!-- 系统节点：主页、桌面、文档、下载、图片、音乐、视频 -->
        <DataTemplate DataType="{x:Type vm:NavItem}">
            <!-- 用两列 Grid 而不是横向 StackPanel：StackPanel 横向测量时给子项无限宽，
                 TextTrimming 永远不触发，文字只会被硬裁。 -->
            <Grid Margin="{StaticResource Padding.NavItem}"
                  VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Margin="0,0,8,0"
                           Style="{StaticResource Text.Glyph}"
                           Text="{Binding Glyph}"/>
                <TextBlock Grid.Column="1"
                           Style="{StaticResource Text.Nav}"
                           Text="{Binding Name}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <!-- 分区标题（位置 / 收藏 / 标签 / 工作区）。不可选中，也不吃鼠标——点它没有任何该发生的事。
             右键是该分区的管理入口：收藏区是新建分组/清理失效项（FR-7.3 / FR-7.7），
             工作区是"保存当前标签"（FR-8.1）。两份菜单靠 IsBookmarks / IsWorkspaces 互斥。

             四个分区标题是侧栏的"自报身份"：位置（系统给的）、收藏（你钉的）、
             标签（条目上的颜色）、工作区（一组标签页快照）是四件互不相干的事，
             没有名字时它们会被读成同一棵树的不同层级。
             第一分区不画上方分隔线——它上面只有主页，再切一刀反而像断了。 -->
        <DataTemplate DataType="{x:Type vm:NavSectionRow}">
            <StackPanel Background="Transparent">
                <Border x:Name="Rule"
                        Height="1"
                        Margin="10,10,10,0"
                        Background="{DynamicResource Brush.Border.Hairline}"/>
                <TextBlock x:Name="Label"
                           Margin="12,6,8,4"
                           Style="{StaticResource Text.NavSection}"
                           Text="{Binding Title}"
                           PreviewMouseLeftButtonDown="OnNavInertRowClick">
                    <TextBlock.ContextMenu>
                        <ContextMenu Style="{StaticResource ContextMenu.Default}"
                                     Opened="OnNavSectionMenuOpening">
                            <MenuItem Style="{StaticResource MenuItem.Default}"
                                      Header="{loc:Tr Key=Bookmark.Group.NewMenu}"
                                      Click="OnBookmarkNewGroup"
                                      Visibility="{Binding IsBookmarks, Converter={StaticResource BoolToVisibility}}"/>
                            <MenuItem Style="{StaticResource MenuItem.Default}"
                                      Header="{loc:Tr Key=Bookmark.CleanMissing}"
                                      Click="OnBookmarkCleanMissing"
                                      Visibility="{Binding IsBookmarks, Converter={StaticResource BoolToVisibility}}"/>
                            <MenuItem Style="{StaticResource MenuItem.Default}"
                                      Header="{loc:Tr Key=Nav.Workspace.SaveCurrent}"
                                      Click="OnWorkspaceSaveCurrent"
                                      Visibility="{Binding IsWorkspaces, Converter={StaticResource BoolToVisibility}}"/>
                        </ContextMenu>
                    </TextBlock.ContextMenu>
                </TextBlock>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFirst}" Value="True">
                    <Setter TargetName="Rule" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 空态提示。折行显示：窄侧栏里"按 Ctrl+D 收藏当前位置"一行放不下 -->
        <DataTemplate DataType="{x:Type vm:NavEmptyRow}">
            <TextBlock Margin="12,0,8,6"
                       Style="{StaticResource Text.Caption}"
                       Text="{Binding Text}"
                       TextWrapping="Wrap"
                       PreviewMouseLeftButtonDown="OnNavInertRowClick"/>
        </DataTemplate>

        <!-- 收藏分组：整行可点，点一下折叠/展开（FR-7.3）。
             点击走 ListBox 的选中事件（见 OnQuickAccessSelectionChanged），不在这里挂
             PreviewMouseLeftButtonDown：行模板带 Margin，点在边距上时事件根本不经过这个 Grid，
             会变成"选中了却没折起来"——那个 bug 就是这么来的。 -->
        <DataTemplate DataType="{x:Type vm:NavGroupRow}">
            <Grid Margin="{StaticResource Padding.NavItem}"
                  Background="Transparent"
                  VerticalAlignment="Center">
                <Grid.ContextMenu>
                    <ContextMenu Style="{StaticResource ContextMenu.Default}">
                        <MenuItem Style="{StaticResource MenuItem.Default}"
                                  Header="{loc:Tr Key=Bookmark.Group.Rename}"
                                  Click="OnBookmarkGroupRename"/>
                        <MenuItem Style="{StaticResource MenuItem.Default}"
                                  Header="{loc:Tr Key=Bookmark.Group.Remove}"
                                  Click="OnBookmarkGroupRemove"/>
                    </ContextMenu>
                </Grid.ContextMenu>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Margin="0,0,4,0"
                           Style="{StaticResource Text.Glyph}"
                           FontSize="{DynamicResource Font.Size.Caption}"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           Text="{Binding ChevronGlyph}"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Style="{StaticResource Text.Nav}"
                           Text="{Binding Title}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <!-- 工作区（FR-8.6）。行标题带标签数，提示里给最后保存时间（FR-8.3）；
             单击 = 打开（会替换当前标签，宿主那边会先问一句），右键是管理入口。 -->
        <DataTemplate DataType="{x:Type vm:NavWorkspaceRow}">
            <Grid Margin="{StaticResource Padding.NavItem}"
                  Background="Transparent"
                  VerticalAlignment="Center"
                  ToolTip="{Binding TooltipText}">
                <Grid.ContextMenu>
                    <ContextMenu Style="{StaticResource ContextMenu.Default}">
                        <MenuItem Style="{StaticResource MenuItem.Default}"
                                  Header="{loc:Tr Key=Workspace.Open}"
                                  Click="OnWorkspaceOpen"/>
                        <MenuItem Style="{StaticResource MenuItem.Default}"
                                  Header="{loc:Tr Key=Workspace.Overwrite}"
                                  Click="OnWorkspaceOverwrite"/>
                        <MenuItem Style="{StaticResource MenuItem.Default}"
                                  Header="{loc:Tr Key=Workspace.Rename}"
                                  Click="OnWorkspaceRename"/>
                        <MenuItem Style="{StaticResource MenuItem.Default}"
                                  Header="{Binding StartupMenuText}"
                                  Click="OnWorkspaceToggleStartup"/>
                        <Separator Style="{StaticResource Menu.Separator}"/>
                        <MenuItem Style="{StaticResource MenuItem.Default}"
                                  Header="{loc:Tr Key=Workspace.Delete}"
                                  Click="OnWorkspaceDelete"/>
                    </ContextMenu>
                </Grid.ContextMenu>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Margin="0,0,8,0"
                           Style="{StaticResource Text.Glyph}"
                           Text="{Binding Glyph}"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Style="{StaticResource Text.Nav}"
                           Text="{Binding Title}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
                <!-- 启动项标记：一个小小的实心点，避免"改了名之后不知道哪份在生效" -->
                <Ellipse Grid.Column="2"
                         Width="6" Height="6"
                         Margin="6,0,0,0"
                         VerticalAlignment="Center"
                         Fill="{DynamicResource Brush.Accent.Default}"
                         ToolTip="{loc:Tr Key=Workspace.SetStartup}"
                         Visibility="{Binding IsStartup, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
        </DataTemplate>

        <!-- 收藏项（FR-7.1 / FR-7.2）。失效项（FR-7.7）文字转次级色，提示里说明原因 -->
        <DataTemplate DataType="{x:Type vm:NavBookmarkRow}">
            <Grid Margin="{StaticResource Padding.NavItem}"
                  Background="Transparent"
                  VerticalAlignment="Center"
                  ToolTip="{Binding TooltipText}"
                  PreviewMouseDown="OnBookmarkMouseDown"
                  PreviewMouseMove="OnBookmarkDragMove">
                <Grid.ContextMenu>
                    <ContextMenu Style="{StaticResource ContextMenu.Default}">
                        <MenuItem Style="{StaticResource MenuItem.Default}"
                                  Header="{loc:Tr Key=Bookmark.Open}"
                                  Click="OnBookmarkOpen"/>
                        <MenuItem Style="{StaticResource MenuItem.Default}"
                                  Header="{loc:Tr Key=Bookmark.OpenNewTab}"
                                  Click="OnBookmarkOpenNewTab"/>
                        <Separator Style="{StaticResource Menu.Separator}"/>
                        <MenuItem Style="{StaticResource MenuItem.Default}"
                                  Header="{loc:Tr Key=Bookmark.Rename}"
                                  Click="OnBookmarkRename"/>
                        <!-- 外观预设（FR-7.5）。子项由数据驱动：ItemsSource 取静态预设表，
                             ItemContainerStyle 里挂同一个 Click，靠 DataContext 区分选了哪个。
                             不在 XAML 里逐条写色块：那样既重复，也会把色值散到界面层。 -->
                        <MenuItem Style="{StaticResource MenuItem.Default}"
                                  Header="{loc:Tr Key=Bookmark.Color}"
                                  ItemsSource="{Binding Source={x:Static vm:BookmarkPresets.Colors}}"
                                  ItemContainerStyle="{StaticResource Bookmark.PresetItem}">
                            <MenuItem.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="12" Height="12"
                                                CornerRadius="2"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Background="{Binding Hex}"/>
                                        <TextBlock Style="{StaticResource Text.Base}" Text="{Binding Name}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </MenuItem.ItemTemplate>
                        </MenuItem>
                        <MenuItem Style="{StaticResource MenuItem.Default}"
                                  Header="{loc:Tr Key=Bookmark.Icon}"
                                  ItemsSource="{Binding Source={x:Static vm:BookmarkPresets.Icons}}"
                                  ItemContainerStyle="{StaticResource Bookmark.PresetItem}">
                            <MenuItem.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Text.Glyph}"
                                                   Margin="0,0,8,0"
                                                   Text="{Binding Glyph}"/>
                                        <TextBlock Style="{StaticResource Text.Base}" Text="{Binding Name}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </MenuItem.ItemTemplate>
                        </MenuItem>
                        <MenuItem Style="{StaticResource MenuItem.Default}"
                                  Header="{loc:Tr Key=Bookmark.Reset}"
                                  Click="OnBookmarkResetAppearance"/>
                        <MenuItem Style="{StaticResource MenuItem.Default}"
                                  Header="{loc:Tr Key=Bookmark.Group.New}"
                                  Click="OnBookmarkMoveToGroup"/>
                        <MenuItem Style="{StaticResource MenuItem.Default}"
                                  Header="{loc:Tr Key=Bookmark.MoveUp}"
                                  Click="OnBookmarkMoveUp"/>
                        <MenuItem Style="{StaticResource MenuItem.Default}"
                                  Header="{loc:Tr Key=Bookmark.MoveDown}"
                                  Click="OnBookmarkMoveDown"/>
                        <Separator Style="{StaticResource Menu.Separator}"/>
                        <MenuItem Style="{StaticResource MenuItem.Default}"
                                  Header="{loc:Tr Key=Bookmark.Remove}"
                                  Click="OnBookmarkRemove"/>
                    </ContextMenu>
                </Grid.ContextMenu>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Margin="0,0,8,0"
                           Text="{Binding Glyph}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Glyph}">
                            <Style.Triggers>
                                <!-- 自定义颜色（FR-7.5）。放在失效触发器之前，失效要能把颜色压回去 -->
                                <DataTrigger Binding="{Binding HasColor}" Value="True">
                                    <Setter Property="Foreground" Value="{Binding GlyphBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="1"
                           Text="{Binding Name}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Nav}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>

        <!-- 标签分区的一行（FR-4.1.5）：实心色点 + 颜色名 + 数量。
             点一下在当前标签里打开该色的聚合视图（列出所有带这个颜色的条目，
             不论它们分散在哪个目录）。 -->
        <DataTemplate DataType="{x:Type vm:NavTagRow}">
            <Grid Margin="{StaticResource Padding.NavItem}"
                  Background="Transparent"
                  VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- 色点用定宽容器，与上面那些 16px 的字形图标左对齐 -->
                <Grid Grid.Column="0" Width="16" Margin="0,0,8,0">
                    <Ellipse Width="10" Height="10"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Left"
                             Margin="3,0,0,0"
                             Fill="{Binding Hex}"/>
                </Grid>
                <TextBlock Grid.Column="1"
                           Style="{StaticResource Text.Nav}"
                           Text="{Binding Title}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!--
        窗口壳。只负责"窗口"这一层：标签栏、导航栏、快捷键、热键、设置、会话。
        浏览区（工具栏 + 地址栏 + 列头 + 列表 + 状态栏）整体下沉到 PaneView，
        原因见 PaneView.xaml.cs 的注释。

        标签栏（FR-2）横跨整窗：标签是窗口级的，不属于某个窗格；
        下面的浏览区只有一份，切标签 = 把它重新绑到另一份视图模型。
        双窗格（FR-3）接入时，Pane 会换成能容纳两个 pane 的 Grid。
    -->

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavColumn" Width="Auto"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
            <!-- 预览窗格（FR-9.1.1）。两列都留在这里，开关只改宽度：
                 关掉时宽度归零，界面上看不出差别，但分隔条与窗格的实例都还在——
                 重建控件会把用户拖动过的宽度、以及正在显示的内容一起丢掉。 -->
            <ColumnDefinition x:Name="PreviewSplitterColumn" Width="0"/>
            <ColumnDefinition x:Name="PreviewColumn" Width="0"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <!-- 标签栏（在顶部时用它，切到底部时高度归零） -->
            <RowDefinition x:Name="TabRowTop" Height="Auto"/>
            <RowDefinition Height="*"/>
            <!-- 侧栏设置入口那一行。高度取窗格状态栏的高度，让两者的上边框连成一条横线 -->
            <RowDefinition Height="Auto"/>
            <!-- 标签栏（在底部时用它）。两行都留着，切换位置只改高度与 Grid.Row，
                 不重建控件——见 ApplyTabStripPosition -->
            <RowDefinition x:Name="TabRowBottom" Height="0"/>
        </Grid.RowDefinitions>

        <Border x:Name="TabFrame"
                Grid.Row="0" Grid.ColumnSpan="5"
                Background="{DynamicResource Brush.Surface.Window}"
                BorderBrush="{DynamicResource Brush.Border.Hairline}"
                BorderThickness="0,0,0,1">
            <views:TabStrip x:Name="TabBar"/>
        </Border>

        <!-- 导航栏（FR-1.2 + FR-7.3）。系统节点与收藏区在**同一条列表**里，
             行模板按类型挑（见 Window.Resources）。宽度取内容宽度并夹在 184–320 之间
             （AC-06 走查修正）：原来写死 184，英文 24pt 下 "Documents / Downloads" 比栏宽还长，
             被 ListBox 直接切掉、连省略号都没有。改为随内容增长，
             中文与常规字号下内容不足 184，宽度与原来完全一致。

             ItemsSource 在代码里赋（NavPanelViewModel.Rows）：这一列的内容是
             "窗格的系统节点 + 窗口的收藏"两部分拼起来的，任何一个 DataContext 都不完整。 -->
        <Grid Grid.Column="0"
              Grid.Row="1"
              MinWidth="{DynamicResource Size.Nav.Width.Default}"
              MaxWidth="{DynamicResource Size.Nav.Width.Max}">
            <ListBox x:Name="QuickAccessList"
                     Style="{StaticResource Nav.Surface}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="OnQuickAccessSelectionChanged"
                     AllowDrop="True"
                     DragOver="OnNavDragOver"
                     DragLeave="OnNavDragLeave"
                     Drop="OnNavDrop"/>

            <!-- 拖拽排序的插入位置指示（FR-7.6）：一条 2px 的横线，压在将要插入的位置上。
                 不拦截鼠标（IsHitTestVisible=False），否则它自己会把 DragOver 抢走。 -->
            <Rectangle x:Name="DropIndicator"
                       Height="2"
                       VerticalAlignment="Top"
                       HorizontalAlignment="Stretch"
                       Margin="4,0,4,0"
                       RadiusX="1"
                       RadiusY="1"
                       Fill="{DynamicResource Brush.Accent.Default}"
                       Visibility="Collapsed"
                       IsHitTestVisible="False"/>
        </Grid>

        <Border Grid.Column="1" Grid.Row="1" Grid.RowSpan="2" Background="{DynamicResource Brush.Border.Hairline}"/>

        <!-- 设置入口（FR-5.1）。占的是第 2 行——与窗格状态栏同一行、同一高度（28）。
             放在这里而不是导航列表下面：列表下面那一块会随窗口长高而变大，
             按钮漂在中间、底下空一片；贴着状态栏这条基线上，才和右侧那条状态栏连成一条。
             设置属于窗口/应用级，放进窗格工具栏会在分屏时变成两颗
             （两个 PaneView 各挂一颗），所以它的位置只能是"全局只有一处"的侧栏。

             这一行不随"显示状态栏"设置隐藏：那是个纯展示设置，不能顺带把唯一的设置入口藏掉。 -->
        <Border x:Name="SettingsHost"
                Grid.Column="0" Grid.Row="2"
                Height="{DynamicResource Size.StatusBar.Height}"
                Background="{DynamicResource Brush.Surface.Sidebar}"
                BorderBrush="{DynamicResource Brush.Border.Hairline}"
                BorderThickness="0,1,0,0">
            <Button x:Name="SettingsButton"
                    Height="Auto"
                    Padding="{StaticResource Padding.NavItem}"
                    Style="{StaticResource Button.NavCommand}"
                    Click="OnSettingsButtonClick"
                    ToolTip="{loc:Tr Key=Toolbar.Settings.Tip}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource Text.Glyph}"
                               Text="&#xE713;"/>
                    <TextBlock VerticalAlignment="Center"
                               Text="{loc:Tr Key=Toolbar.Settings}"/>
                </StackPanel>
            </Button>
        </Border>

        <!-- 浏览区宿主（FR-3）。平时只放主窗格；开分屏时第二列（或第二行）显示第二个
             PaneView，中间是可拖的分隔条。两个 PaneView 各自持有工具栏/列头/列表/状态栏，
             因为两个窗格的路径、选中、项数都是独立的。

             不用两个 Grid 切换形态：行列定义固定为 3×3，切换左右/上下时只改
             "哪些行列非零"和子元素的 Grid 定位（见 MainWindow.ApplySplitLayout），
             这样分隔条的拖拽逻辑不用写两份。 -->
        <Grid x:Name="PaneHost"
              Grid.Column="2" Grid.Row="1" Grid.RowSpan="2"
              Background="{DynamicResource Brush.Surface.Window}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FirstColumn" Width="*"/>
                <ColumnDefinition x:Name="SplitterColumn" Width="0"/>
                <ColumnDefinition x:Name="SecondColumn" Width="0"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="FirstRow" Height="*"/>
                <RowDefinition x:Name="SplitterRow" Height="0"/>
                <RowDefinition x:Name="SecondRow" Height="0"/>
            </Grid.RowDefinitions>

            <!-- 主页（FR-1.1）。与 PaneView 一样只有一份实例：主页视图模型是窗口级的，
                 多个主页标签共用它。显示主页时它会横跨整个 PaneHost，两个窗格一起让位——
                 主页不"位于"任何目录，没有第二个位置可以分屏。 -->
            <views:HomeView x:Name="Home" Grid.Column="0" Grid.Row="0" Visibility="Collapsed"/>

            <!-- 标签结果（FR-4.1.5）。同样是窗口级单件：结果列表按当前标签的颜色现取，
                 开多个标签看不同颜色时共用这一份视图模型，切换时只重填内容。 -->
            <views:TagResultsView x:Name="TagResults" Grid.Column="0" Grid.Row="0" Visibility="Collapsed"/>

            <views:PaneView x:Name="Pane" Grid.Column="0" Grid.Row="0"/>

            <GridSplitter x:Name="ColumnSplitter"
                          Grid.Column="1" Grid.Row="0"
                          Width="{DynamicResource Size.Splitter.Thickness}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Background="Transparent"
                          Visibility="Collapsed"
                          DragCompleted="OnSplitterDragCompleted"
                          MouseDoubleClick="OnSplitterDoubleClick">
                <GridSplitter.ContextMenu>
                    <ContextMenu Style="{StaticResource ContextMenu.Default}">
                        <MenuItem Style="{StaticResource MenuItem.Default}"
                                  Header="{loc:Tr Key=Split.Menu.Horizontal}"
                                  Click="OnSplitHorizontal"/>
                        <MenuItem Style="{StaticResource MenuItem.Default}"
                                  Header="{loc:Tr Key=Split.Menu.Vertical}"
                                  Click="OnSplitVertical"/>
                        <MenuItem Style="{StaticResource MenuItem.Default}"
                                  Header="{loc:Tr Key=Split.Menu.Reset}"
                                  Click="OnSplitReset"/>
                    </ContextMenu>
                </GridSplitter.ContextMenu>
            </GridSplitter>

            <GridSplitter x:Name="RowSplitter"
                          Grid.Column="0" Grid.Row="1"
                          Height="{DynamicResource Size.Splitter.Thickness}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext"
                          Background="Transparent"
                          Visibility="Collapsed"
                          DragCompleted="OnSplitterDragCompleted"
                          MouseDoubleClick="OnSplitterDoubleClick">
                <GridSplitter.ContextMenu>
                    <ContextMenu Style="{StaticResource ContextMenu.Default}">
                        <MenuItem Style="{StaticResource MenuItem.Default}"
                                  Header="{loc:Tr Key=Split.Menu.Horizontal}"
                                  Click="OnSplitHorizontal"/>
                        <MenuItem Style="{StaticResource MenuItem.Default}"
                                  Header="{loc:Tr Key=Split.Menu.Vertical}"
                                  Click="OnSplitVertical"/>
                        <MenuItem Style="{StaticResource MenuItem.Default}"
                                  Header="{loc:Tr Key=Split.Menu.Reset}"
                                  Click="OnSplitReset"/>
                    </ContextMenu>
                </GridSplitter.ContextMenu>
            </GridSplitter>

            <views:PaneView x:Name="Pane2" Grid.Column="2" Grid.Row="0" Visibility="Collapsed"/>
        </Grid>

        <!-- 预览分隔条。ResizeBehavior 取 PreviousAndNext：左边是列表（星号列）、
             右边是预览（固定像素列），拖动就是在"列表让出多少"与"预览占多少"之间挪边界。 -->
        <GridSplitter x:Name="PreviewSplitter"
                      Grid.Column="3" Grid.Row="1" Grid.RowSpan="2"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      Background="Transparent"
                      Visibility="Collapsed"
                      DragCompleted="OnPreviewSplitterDragCompleted"
                      MouseDoubleClick="OnPreviewSplitterDoubleClick"/>

        <views:PreviewPane x:Name="Preview"
                           Grid.Column="4" Grid.Row="1" Grid.RowSpan="2"
                           MinWidth="{DynamicResource Size.Preview.MinWidth}"
                           Visibility="Collapsed"/>
    </Grid>
</Window>
