<Window x:Class="Lingpane.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Lingpane.App.Converters"
        Title="Lingpane"
        Height="720" Width="1100"
        MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Surface.Window}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏：M0 只显示当前路径。标签页与双窗格在 M2 接入 -->
        <Border Grid.Row="0"
                Height="{DynamicResource Size.Toolbar.Height}"
                Background="{DynamicResource Brush.Surface.Window}"
                BorderBrush="{DynamicResource Brush.Border.Hairline}"
                BorderThickness="0,0,0,1">
            <TextBlock Margin="{StaticResource Padding.Toolbar}"
                       VerticalAlignment="Center"
                       Style="{StaticResource Text.Secondary}"
                       Text="{Binding CurrentPath}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding CurrentPath}"/>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 常用目录（FR-1.1） -->
            <ListBox x:Name="QuickAccessList"
                     Grid.Column="0"
                     Width="{DynamicResource Size.Nav.Width.Default}"
                     Style="{StaticResource Nav.Surface}"
                     ItemsSource="{Binding QuickAccess}"
                     SelectionChanged="OnQuickAccessSelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal"
                                    Margin="{StaticResource Padding.NavItem}"
                                    VerticalAlignment="Center">
                            <TextBlock Margin="0,0,8,0"
                                       Style="{StaticResource Text.Glyph}"
                                       Text="{Binding Glyph}"/>
                            <TextBlock Style="{StaticResource Text.Nav}"
                                       Text="{Binding Name}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Column="1" Background="{DynamicResource Brush.Border.Hairline}"/>

            <!-- 文件列表：虚拟化三件套在 List.Surface 中统一开启（R-01） -->
            <ListBox x:Name="FileList"
                     Grid.Column="2"
                     Style="{StaticResource List.Surface}"
                     ItemsSource="{Binding Entries}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="{DynamicResource Size.Row.Active}"
                              Margin="{StaticResource Padding.Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 标签点槽位：始终占位，否则有标签的行文件名会整体右移（规则 3.2） -->
                            <Border Grid.Column="0" Width="{DynamicResource Size.Tag.Gutter}"/>

                            <Image Grid.Column="1"
                                   Width="{DynamicResource Size.Icon.List}"
                                   Height="{DynamicResource Size.Icon.List}"
                                   Source="{Binding IconKey,
                                            Converter={x:Static conv:IconKeyToImageConverter.Instance}}"/>

                            <TextBlock Grid.Column="2"
                                       Margin="8,0,8,0"
                                       Style="{StaticResource Text.Row}"
                                       Text="{Binding Name}"
                                       ToolTip="{Binding Name}"/>

                            <TextBlock Grid.Column="3"
                                       Width="{DynamicResource Column.Date.Width}"
                                       Style="{StaticResource Text.Secondary}"
                                       Typography.NumeralAlignment="Tabular"
                                       Text="{Binding DateText}"/>

                            <TextBlock Grid.Column="4"
                                       Width="{DynamicResource Column.Size.Width}"
                                       Style="{StaticResource Text.Number}"
                                       Text="{Binding SizeText}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Border Grid.Row="2"
                Height="{DynamicResource Size.StatusBar.Height}"
                Background="{DynamicResource Brush.Surface.Window}"
                BorderBrush="{DynamicResource Brush.Border.Hairline}"
                BorderThickness="0,1,0,0">
            <TextBlock Margin="{StaticResource Padding.StatusBar}"
                       VerticalAlignment="Center"
                       Style="{StaticResource Text.Caption}"
                       Text="{Binding StatusText}"/>
        </Border>
    </Grid>
</Window>
