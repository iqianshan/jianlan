<UserControl x:Class="Lingpane.App.Views.WindowControls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Lingpane.App.Localization"
             VerticalAlignment="Center"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed">

    <!--
        窗口键（FR-10.11）：最小化 / 最大化（还原）/ 关闭。

        三个按钮都要标 WindowChrome.IsHitTestVisibleInChrome：
        它们落在 CaptionHeight 划出的标题栏区域里，不标就等于把点击交给系统去当"拖动标题栏"，
        按下去窗口会跟着鼠标走，按钮永远不响应。

        图标与提示文字在 code-behind 里按 WindowState 写：最大化态要把方框换成"两个叠放方框"，
        纯 XAML 的 DataTrigger 也能做，但触发源的 WindowState 在 UserControl 里拿不到，
        只能靠 RelativeSource 找 Window，绕一圈还不如直接订阅 StateChanged。
    -->
    <StackPanel Orientation="Horizontal">
        <Button x:Name="MinButton"
                Style="{StaticResource Button.WindowControl}"
                WindowChrome.IsHitTestVisibleInChrome="True"
                Click="OnMinimizeClick">
            <TextBlock x:Name="MinGlyph"/>
        </Button>

        <Button x:Name="MaxButton"
                Style="{StaticResource Button.WindowControl}"
                WindowChrome.IsHitTestVisibleInChrome="True"
                Click="OnMaximizeClick">
            <TextBlock x:Name="MaxGlyph"/>
        </Button>

        <Button x:Name="CloseButton"
                Style="{StaticResource Button.WindowClose}"
                WindowChrome.IsHitTestVisibleInChrome="True"
                Click="OnCloseClick"
                ToolTip="{loc:Tr Key=A11y.WindowClose}">
            <TextBlock Text="&#xE106;"/>
        </Button>
    </StackPanel>
</UserControl>
