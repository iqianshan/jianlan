<Window x:Class="Lingpane.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Lingpane.App.Localization"
        Title="{loc:Tr Key=About.Title}"
        Icon="pack://application:,,,/Lingpane;component/Assets/Brand/lingpane.ico"
        Width="480" Height="680"
        MinWidth="420" MinHeight="440"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Surface.Window}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <!--
        关于页（FR-10.8）。独立窗口而不是设置页的一节：许可证全文与依赖清单
        是两份长文本，塞进设置页会把「隐私」那一段推到首屏之外（见 docs/about-page.md §二）。
        非模态：用户经常一边看版本号一边继续用主窗口。
    -->

    <Window.Resources>
        <!-- 左列标签定宽，右侧值左边缘对齐；宽度随字号缩放，24pt 下不会被截 -->
        <Style x:Key="About.Label" TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
            <Setter Property="Width" Value="{DynamicResource Size.FieldLabel.Width}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="About.Value" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 路径这类"很长但必须能看全"的值：省略号 + 悬停看全文，
             换行会让三个目录占掉半屏 -->
        <Style x:Key="About.Path" TargetType="TextBlock" BasedOn="{StaticResource About.Value}">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Mono}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
            <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 头部：标识 + 名称 + 一句话定位 -->
        <Border Grid.Row="0"
                Padding="{StaticResource Padding.Dialog}"
                BorderBrush="{DynamicResource Brush.Border.Hairline}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <!--
                    品牌图形（概念 A · 棂格）。用 DynamicResource 而不是写死路径：
                    图形是"深色描边 + 强调色实心格"的单色稿，深底上直接用会糊，
                    三套主题各指一份（见 Themes/Theme.*.xaml 的 Image.Brand.Mark）。
                    源图取 128px：48 DIP 在 200% 缩放下要 96px，128 有余量又不浪费。
                    Uniform 而非 Fill——以后换成长宽不等的稿也不会被拉变形。
                -->
                <Image Width="48" Height="48"
                       Source="{DynamicResource Image.Brand.Mark}"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Text.Title}"
                               Text="{loc:Tr Key=Application.Name}"/>
                    <TextBlock Margin="0,2,0,0"
                               Style="{StaticResource Text.Caption.Wrap}"
                               Text="{loc:Tr Key=About.Tagline}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      Padding="{StaticResource Padding.Dialog}"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- 版本号自己就是标题，不再单起一行「版本」 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBlock x:Name="VersionText" Style="{StaticResource Text.Subtitle}"/>
                    <!-- 构建标识（短 commit）排在版本号右下，小字 -->
                    <TextBlock x:Name="BuildTagText"
                               Margin="8,0,0,2"
                               VerticalAlignment="Bottom"
                               Style="{StaticResource Text.Caption}"/>
                </StackPanel>

                <!-- ══ 运行环境 ══
                     四行而不是 2×2：系统版本串本身就占满一整行
                     （"Microsoft Windows 10.0.26300 (10.0.26300.0)"），
                     挤进半宽只会全部变成省略号。行距压到 4，四行只比两行高一点。 -->
                <TextBlock Margin="0,0,0,4"
                           Style="{StaticResource Text.SectionTitle}"
                           Text="{loc:Tr Key=About.Section.Environment}"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Style="{StaticResource About.Label}"
                               Text="{loc:Tr Key=About.Env.Runtime}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               x:Name="RuntimeText"
                               Style="{StaticResource About.Value}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Margin="0,4,0,0"
                               Style="{StaticResource About.Label}"
                               Text="{loc:Tr Key=About.Env.OS}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               x:Name="OsText"
                               Margin="0,4,0,0"
                               Style="{StaticResource About.Value}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Margin="0,4,0,0"
                               Style="{StaticResource About.Label}"
                               Text="{loc:Tr Key=About.Env.Arch}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1"
                               x:Name="ArchText"
                               Margin="0,4,0,0"
                               Style="{StaticResource About.Value}"/>

                    <TextBlock Grid.Row="3" Grid.Column="0"
                               Margin="0,4,0,0"
                               Style="{StaticResource About.Label}"
                               Text="{loc:Tr Key=About.Env.Memory}"/>
                    <TextBlock Grid.Row="3" Grid.Column="1"
                               x:Name="MemoryText"
                               Margin="0,4,0,0"
                               Style="{StaticResource About.Value}"/>
                </Grid>

                <!-- ══ 许可 ══ -->
                <TextBlock Margin="0,0,0,4"
                           Style="{StaticResource Text.SectionTitle}"
                           Text="{loc:Tr Key=About.Section.License}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Style="{StaticResource About.Label}" Text="{loc:Tr Key=About.License.Name}"/>
                    <TextBlock Style="{StaticResource Text.Base}" Text="Apache-2.0"/>
                </StackPanel>
                <!-- 三份文本不进 XAML：11KB 的许可证进了 BAML 就是白白多一份加载成本，
                     且法律文本不该参与本地化。见 Services/LegalResources.cs -->
                <WrapPanel Margin="0,0,0,12">
                    <Button Style="{StaticResource Button.Toolbar}"
                            Content="{loc:Tr Key=About.License.View}"
                            Click="OnViewLicense"/>
                    <Button Style="{StaticResource Button.Toolbar}"
                            Content="{loc:Tr Key=About.License.Notice}"
                            Click="OnViewNotice"/>
                    <Button Style="{StaticResource Button.Toolbar}"
                            Content="{loc:Tr Key=About.License.ThirdParty}"
                            Click="OnViewThirdParty"/>
                </WrapPanel>

                <!-- ══ 目录（FR-10.9）══ -->
                <TextBlock Margin="0,0,0,4"
                           Style="{StaticResource Text.SectionTitle}"
                           Text="{loc:Tr Key=About.Section.Paths}"/>
                <!-- 路径与"便携模式"说明合并在同一行：拆成两行只是为了多占 20px -->
                <TextBlock x:Name="RootPathText"
                           Margin="0,0,0,6"
                           Style="{StaticResource About.Path}"/>
                <WrapPanel Margin="0,0,0,12">
                    <Button Style="{StaticResource Button.Toolbar}"
                            Content="{loc:Tr Key=About.Paths.Config}"
                            Click="OnOpenConfigDir"/>
                    <Button Style="{StaticResource Button.Toolbar}"
                            Content="{loc:Tr Key=About.Paths.Logs}"
                            Click="OnOpenLogsDir"/>
                    <Button Style="{StaticResource Button.Toolbar}"
                            Content="{loc:Tr Key=About.Paths.Data}"
                            Click="OnOpenDataDir"/>
                </WrapPanel>

                <!-- ══ 诊断与更新 ══
                     两个动作各一颗按钮，说明放进 ToolTip：这一段本来就只有两句话，
                     摊成"标题 + 按钮 + 说明"三行会把整个页面撑出滚动条。 -->
                <TextBlock Margin="0,0,0,4"
                           Style="{StaticResource Text.SectionTitle}"
                           Text="{loc:Tr Key=About.Section.Tools}"/>
                <WrapPanel Margin="0,0,0,10">
                    <Button Style="{StaticResource Button.Toolbar}"
                            Content="{loc:Tr Key=About.Logs.Export}"
                            ToolTip="{loc:Tr Key=About.Logs.Hint}"
                            Click="OnExportLogs"/>
                    <Button Style="{StaticResource Button.Toolbar}"
                            Content="{loc:Tr Key=About.Diagnostics.Copy}"
                            ToolTip="{loc:Tr Key=About.Diagnostics.Hint}"
                            Click="OnCopyDiagnostics"/>
                    <Button Style="{StaticResource Button.Toolbar}"
                            Content="{loc:Tr Key=About.Update.Check}"
                            ToolTip="{loc:Tr Key=About.Update.Hint}"
                            Click="OnCheckUpdates"/>
                </WrapPanel>

                <!-- 隐私（FR-5.3.7）：与设置页同一段文案，两处说法必须一致。
                     不加小节标题——它是对上面那颗「检查更新」的说明，不是独立一栏。 -->
                <TextBlock Style="{StaticResource Text.Caption.Wrap}"
                           Text="{loc:Tr Key=Settings.About.Privacy}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部：左边是操作结果（复制成功 / 打不开目录），右边关闭 -->
        <Border Grid.Row="2"
                Padding="{StaticResource Padding.Dialog}"
                BorderBrush="{DynamicResource Brush.Border.Hairline}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText"
                           Grid.Column="0"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource Text.Caption}"/>

                <Button Grid.Column="1"
                        MinWidth="72"
                        Style="{StaticResource Button.Toolbar}"
                        Content="{loc:Tr Key=Common.Close}"
                        Click="OnClose"/>
            </Grid>
        </Border>
    </Grid>
</Window>
