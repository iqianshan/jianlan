<Window x:Class="Lingpane.App.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Lingpane.App.Localization"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Surface.Window}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <!--
        通用文本输入框（新建文件夹 / 重命名）。
        不做行内编辑：行内编辑要在虚拟化行模板里抢焦点、处理 Enter/Esc 与滚动回收，
        出错面比一个独立窗口大得多，而收益只是少点一次。
    -->
    <StackPanel Margin="{StaticResource Padding.Dialog}">
        <TextBlock x:Name="PromptText" Style="{StaticResource Text.Base}"/>

        <TextBox x:Name="Input"
                 Margin="0,8,0,0"
                 Style="{StaticResource TextBox.Address}"
                 KeyDown="OnInputKeyDown"/>

        <TextBlock x:Name="ErrorText"
                   Margin="0,6,0,0"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Foreground="{DynamicResource Brush.Status.Danger}"
                   FontSize="{DynamicResource Font.Size.Caption}"/>

        <StackPanel Margin="0,16,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Style="{StaticResource Button.Toolbar}"
                    Content="{loc:Tr Key=Dialog.Cancel}"
                    IsCancel="True"
                    MinWidth="72"
                    Click="OnCancel"/>
            <Button Style="{StaticResource Button.Toolbar}"
                    Content="{loc:Tr Key=Dialog.Ok}"
                    IsDefault="True"
                    MinWidth="72"
                    Click="OnConfirm"/>
        </StackPanel>
    </StackPanel>
</Window>
