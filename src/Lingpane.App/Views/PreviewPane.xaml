<UserControl x:Class="Lingpane.App.Views.PreviewPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Lingpane.App.Localization"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed">

    <!--
        预览窗格（FR-9.1）。窗口右侧一栏，反映**活动窗格**的选中项——
        分屏时两个窗格共用一个预览，因为预览回答的是"我此刻在看什么"，
        而不是"每个窗格各有一个预览"。

        四层内容共用同一个格子（空态 / 多选 / 图片 / 文本 / 说明），
        靠 Visibility 切换而不是换模板：换模板要重建可视化树，
        每次上下键选中都会闪一下。
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- 说明态里的「立即预览」按钮。只在延后触发（网络/可移动设备）时出现 -->
        <Style x:Key="Button.PreviewRetry" TargetType="Button" BasedOn="{StaticResource Button.NavCommand}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource Brush.Surface.Sidebar}"
            BorderBrush="{DynamicResource Brush.Border.Hairline}"
            BorderThickness="1,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题块：文件名 + 类型/大小/日期 + 完整路径。
                 路径折两行封顶：再长就该看提示了，不能把这栏撑成一段说明文。 -->
            <StackPanel Grid.Row="0" Margin="16,14,16,10">
                <TextBlock Style="{StaticResource Text.Base}"
                           FontWeight="{DynamicResource Font.Weight.Emphasis}"
                           Text="{Binding TitleText}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"/>

                <TextBlock Margin="0,4,0,0"
                           Style="{StaticResource Text.Caption}"
                           Text="{Binding MetaText}"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}"/>

                <TextBlock Margin="0,2,0,0"
                           Style="{StaticResource Text.Caption}"
                           Text="{Binding PathText}"
                           TextWrapping="Wrap"
                           MaxHeight="32"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding PathText}"
                           Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <!-- 内容区 -->
            <Grid Grid.Row="1" Margin="16,0,16,0">
                <!-- 空态：一句提示居中偏上，不做垂直居中——居中会让整个窗格像一块空白面板 -->
                <TextBlock VerticalAlignment="Top"
                           Margin="0,8,0,0"
                           Style="{StaticResource Text.Caption}"
                           Text="{loc:Tr Key=Preview.Empty}"
                           TextWrapping="Wrap"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>

                <!-- 多选（FR-9.1.6）不在这里重复一遍：标题块已经写了"已选中 N 项 / 共 X"，
                     再画一次就是同一句话上下各一份。这里留空，让"没有单个文件可看"自己说明问题。 -->

                <!-- 图片。解码时已按窗格宽度限幅，这里只管等比铺满 -->
                <Image x:Name="PreviewImage"
                       Source="{Binding Image}"
                       Stretch="Uniform"
                       StretchDirection="DownOnly"
                       VerticalAlignment="Top"
                       HorizontalAlignment="Stretch"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibility}}"/>

                <!-- 文本。只读 TextBox 而不是 TextBlock：用户要能选中、复制其中一段，
                     这在"看一眼配置文件"的场景里比什么都实用。 -->
                <TextBox Text="{Binding TextContent, Mode=OneWay}"
                         IsReadOnly="True"
                         IsReadOnlyCaretVisible="True"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="NoWrap"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="0"
                         FontFamily="{DynamicResource Font.Family.Mono}"
                         FontSize="{DynamicResource Font.Size.Caption}"
                         Foreground="{DynamicResource Brush.Text.Primary}"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalAlignment="Stretch"
                         Visibility="{Binding HasText, Converter={StaticResource BoolToVisibility}}"/>

                <!-- 取不到内容：图标 + 一句说明（FR-9.1.4）。不报错、不弹窗。
                     图标按 32px 原生尺寸画：系统图标只有 16/32 两档，硬放大只会得到一团白块。 -->
                <StackPanel VerticalAlignment="Top"
                            Margin="0,8,0,0"
                            Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}">
                    <Image Width="32" Height="32"
                           HorizontalAlignment="Left"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="{Binding Icon}"/>
                    <TextBlock Margin="0,12,0,0"
                               Style="{StaticResource Text.Caption}"
                               Text="{Binding NoteText}"
                               TextWrapping="Wrap"/>
                    <Button Style="{StaticResource Button.PreviewRetry}"
                            Content="{loc:Tr Key=Preview.DeferredAction}"
                            Click="OnRetryClick"
                            Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Grid>

            <!-- 脚注：截断提示这类补充说明，没有内容时不占高度 -->
            <TextBlock Grid.Row="2"
                       Margin="16,8,16,12"
                       Text="{Binding FooterText}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                        <Setter Property="TextWrapping" Value="Wrap"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FooterText}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Border>
</UserControl>
