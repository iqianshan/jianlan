<UserControl x:Class="Lingpane.App.Views.PaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Lingpane.App.Converters"
             xmlns:loc="clr-namespace:Lingpane.App.Localization"
             xmlns:local="clr-namespace:Lingpane.App.Views"
             Background="{DynamicResource Brush.Surface.Window}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed">

    <!--
        浏览区：一个窗格就是一个 PaneView。
        多标签（FR-2）与双窗格（FR-3）上线后，窗口里会同时存在一到两个实例，
        每个实例自带工具栏、列头、列表与状态栏——因为两个窗格的路径、选中、项数
        都是独立的，共用一套界面必然要在代码里到处判"这是哪个窗格"。
    -->

    <UserControl.Resources>
        <!-- 视图切换按钮：选中项用选中底色区分，不做边框加粗，避免工具栏跳动 -->
        <Style x:Key="ViewButton.Details" TargetType="Button" BasedOn="{StaticResource Button.Toolbar}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDetailsView}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Selected}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnSelected}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ViewButton.List" TargetType="Button" BasedOn="{StaticResource Button.Toolbar}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsListView}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Selected}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnSelected}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 分屏开关：激活态与"详细/列表"同一套选中视觉，让人一眼看出"这个状态是开着的"。
             状态读的是 PaneView 自己的依赖属性而不是视图模型：分屏是窗口形态，
             不随标签/路径变，挂在 PaneViewModel 上会让每个标签各存一份假状态。 -->
        <Style x:Key="ViewButton.Split" TargetType="Button" BasedOn="{StaticResource Button.Toolbar}">
            <Setter Property="Width" Value="{DynamicResource Size.Row.Comfortable}"/>
            <Setter Property="Padding" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSplitActive, RelativeSource={RelativeSource AncestorType={x:Type local:PaneView}}}"
                             Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Selected}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnSelected}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 面包屑段之间的分隔符：第一段前不显示（PreviousData 为 null 即首项） -->
        <Style x:Key="Breadcrumb.Separator" TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
            <Setter Property="Text" Value="›"/>
            <Setter Property="Margin" Value="2,0,2,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- 焦点包边（FR-3.5）。只在分屏时由宿主打开：单窗格包个框除了多一条线没有别的信息。
         BorderThickness 由 PaneView.SetActive 切换，颜色是 1px Brush.Border.Strong（ui-guidelines 规则 10.2）。 -->
    <Border x:Name="OutlineHost"
            BorderThickness="0"
            BorderBrush="{DynamicResource Brush.Border.Strong}">
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏：导航 + 地址栏 + 视图切换 -->
        <Border Grid.Row="0"
                Height="{DynamicResource Size.Toolbar.Height}"
                Background="{DynamicResource Brush.Surface.Window}"
                BorderBrush="{DynamicResource Brush.Border.Hairline}"
                BorderThickness="0,0,0,1">
            <Grid Margin="{StaticResource Padding.Toolbar}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 导航命令：与快捷键共用同一批命令对象，禁用状态由 CanExecute 决定 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Toolbar}"
                            Command="{Binding BackCommand, RelativeSource={RelativeSource AncestorType={x:Type local:PaneView}}}"
                            Content="←"
                            ToolTip="{loc:Tr Key=Toolbar.Back}"/>
                    <Button Style="{StaticResource Button.Toolbar}"
                            Command="{Binding ForwardCommand, RelativeSource={RelativeSource AncestorType={x:Type local:PaneView}}}"
                            Content="→"
                            ToolTip="{loc:Tr Key=Toolbar.Forward}"/>
                    <Button Style="{StaticResource Button.Toolbar}"
                            Command="{Binding UpCommand, RelativeSource={RelativeSource AncestorType={x:Type local:PaneView}}}"
                            Content="↑"
                            ToolTip="{loc:Tr Key=Toolbar.Up}"/>
                    <Button Style="{StaticResource Button.Toolbar}"
                            Command="{Binding RefreshCommand, RelativeSource={RelativeSource AncestorType={x:Type local:PaneView}}}"
                            Content="⟳"
                            ToolTip="{loc:Tr Key=Toolbar.Refresh}"/>
                </StackPanel>

                <!-- 地址栏：面包屑 ↔ 可编辑完整路径（Ctrl+L 或点击空白处切换） -->
                <Grid Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center">
                    <ItemsControl x:Name="BreadcrumbHost" ItemsSource="{Binding Breadcrumbs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Breadcrumb.Separator}"/>
                                    <Button Style="{StaticResource Button.Link}"
                                            Content="{Binding Label}"
                                            Tag="{Binding FullPath}"
                                            Click="OnBreadcrumbClick"
                                            ToolTip="{Binding FullPath}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAddressEditing}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                    </ItemsControl>

                    <TextBox x:Name="AddressBox"
                             Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="OnAddressKeyDown"
                             TextChanged="OnAddressTextChanged"
                             LostKeyboardFocus="OnAddressLostFocus">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource TextBox.Address}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAddressEditing}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- 地址栏补全候选（FR-6.1）。
                         用 Popup 而不是 ComboBox：ComboBox 自带 TextBox 与下拉之间的焦点争夺，
                         "边打字边跳"的场景下会把焦点抢走，补全一开就输不进去了。
                         Focusable=False 是刻意为之——候选区一拿到焦点，地址栏就失焦退出编辑态，
                         候选还没点完就被收走。 -->
                    <Popup x:Name="CompletionPopup"
                           PlacementTarget="{Binding ElementName=AddressBox}"
                           Placement="Bottom"
                           StaysOpen="True"
                           AllowsTransparency="True"
                           Focusable="False"
                           MaxHeight="248">
                        <Border Margin="0,2,0,0"
                                MinWidth="{Binding ActualWidth, ElementName=AddressBox}"
                                Background="{DynamicResource Brush.Surface.Floating}"
                                BorderBrush="{DynamicResource Brush.Border.Hairline}"
                                BorderThickness="1">
                            <ListBox x:Name="CompletionList"
                                     MaxHeight="240"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Focusable="False"
                                     ItemContainerStyle="{StaticResource Row.Item}"
                                     PreviewMouseLeftButtonUp="OnCompletionItemClick"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="26">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- 图标与列表行同一套键、同一个转换器，避免"补全里是一种图标、
                                                 列表里是另一种"；只看图标分不清同名目录与文件，
                                                 所以右侧另给「文件夹/文件」文字 -->
                                            <Image Grid.Column="0"
                                                   Width="{DynamicResource Size.Icon.List}"
                                                   Height="{DynamicResource Size.Icon.List}"
                                                   Margin="10,0,8,0"
                                                   VerticalAlignment="Center"
                                                   Source="{Binding IconToken,
                                                            Converter={x:Static conv:IconKeyToImageConverter.Instance}}"/>
                                            <TextBlock Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource Text.Row}"
                                                       Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2"
                                                       Margin="12,0,10,0"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource Text.Secondary}"
                                                       Text="{Binding KindText}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>
                </Grid>

                <!-- 视图切换 + 分屏开关。
                     分屏是窗口级状态（FR-3.3），但开关放在主窗格工具栏上：
                     用户点"详细/列表"的地方就是他觉得"这块区域长什么样"的地方，
                     分屏同理。第二窗格不显示这颗按钮（见 PaneView.ShowSplitButton），
                     否则分屏时会冒出两颗一模一样的开关。 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="DetailsButton"
                            Style="{StaticResource ViewButton.Details}"
                            Command="{Binding DetailsCommand, RelativeSource={RelativeSource AncestorType={x:Type local:PaneView}}}"
                            Content="{loc:Tr Key=Toolbar.Details}"
                            ToolTip="{loc:Tr Key=Toolbar.Details.Tip}"/>
                    <Button x:Name="ListButton"
                            Style="{StaticResource ViewButton.List}"
                            Command="{Binding ListViewCommand, RelativeSource={RelativeSource AncestorType={x:Type local:PaneView}}}"
                            Content="{loc:Tr Key=Toolbar.List}"
                            ToolTip="{loc:Tr Key=Toolbar.List.Tip}"/>

                    <Border x:Name="SplitDivider"
                            Width="1"
                            Margin="4,8,8,8"
                            Background="{DynamicResource Brush.Border.Hairline}"/>

                    <Button x:Name="SplitButton"
                            Style="{StaticResource ViewButton.Split}"
                            Command="{Binding ToggleSplitCommand, RelativeSource={RelativeSource AncestorType={x:Type local:PaneView}}}"
                            ToolTip="{loc:Tr Key=Toolbar.Split.Tip}"
                            AutomationProperties.Name="{loc:Tr Key=Toolbar.Split.Tip}">
                        <!-- 图标自绘：Segoe MDL2 没有语义明确的"左右分栏"字形，
                             用方框 + 中线比借一个"平铺/窗口"字形更不容易被误解。 -->
                        <Viewbox Width="15" Height="15">
                            <Canvas Width="15" Height="15">
                                <Rectangle Canvas.Left="1.5" Canvas.Top="3.5"
                                           Width="12" Height="8"
                                           RadiusX="1.2" RadiusY="1.2"
                                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                           StrokeThickness="1.3"/>
                                <Line X1="7.5" Y1="3.5" X2="7.5" Y2="11.5"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      StrokeThickness="1.3"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 列头：只在详细信息视图显示，列宽与行模板保持一致 -->
            <Border Grid.Row="0"
                    Height="{DynamicResource Size.Row.Header}"
                    Background="{DynamicResource Brush.Surface.Window}"
                    BorderBrush="{DynamicResource Brush.Border.Hairline}"
                    BorderThickness="0,0,0,1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDetailsView}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid x:Name="HeaderGrid" Margin="{StaticResource Padding.Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="{DynamicResource Size.Tag.Gutter}"/>
                    <Border Grid.Column="1" Width="{DynamicResource Size.Icon.List}"/>

                    <Button Grid.Column="2"
                            x:Name="NameHeaderButton"
                            Style="{StaticResource Button.Header}"
                            Content="{Binding NameHeader}"
                            Tag="Name"
                            Click="OnSortClick"
                            ToolTip="{loc:Tr Key=Sort.ByName}"/>
                    <Button Grid.Column="3"
                            x:Name="DateHeaderButton"
                            Style="{StaticResource Button.Header}"
                            Width="{DynamicResource Column.Date.Width}"
                            Content="{Binding DateHeader}"
                            Tag="Date"
                            Click="OnSortClick"
                            ToolTip="{loc:Tr Key=Sort.ByDateModified}"/>
                    <Thumb Grid.Column="3"
                           Style="{StaticResource Thumb.ColumnResize}"
                           Tag="Column.Date.Width"
                           DragDelta="OnColumnResize"
                           DragCompleted="OnColumnResizeDone"/>
                    <Button Grid.Column="4"
                            x:Name="TypeHeaderButton"
                            Style="{StaticResource Button.Header}"
                            Width="{DynamicResource Column.Type.Width}"
                            Content="{Binding TypeHeader}"
                            Tag="Type"
                            Click="OnSortClick"
                            ToolTip="{loc:Tr Key=Sort.ByType}"/>
                    <Thumb Grid.Column="4"
                           Style="{StaticResource Thumb.ColumnResize}"
                           Tag="Column.Type.Width"
                           DragDelta="OnColumnResize"
                           DragCompleted="OnColumnResizeDone"/>
                    <Button Grid.Column="5"
                            x:Name="SizeHeaderButton"
                            Style="{StaticResource Button.Header}"
                            Width="{DynamicResource Column.Size.Width}"
                            Content="{Binding SizeHeader}"
                            Tag="Size"
                            Click="OnSortClick"
                            HorizontalContentAlignment="Right"
                            ToolTip="{loc:Tr Key=Sort.BySize}"/>
                    <Thumb Grid.Column="5"
                           Style="{StaticResource Thumb.ColumnResize}"
                           Tag="Column.Size.Width"
                           DragDelta="OnColumnResize"
                           DragCompleted="OnColumnResizeDone"/>
                </Grid>
            </Border>

            <!-- 文件列表：虚拟化三件套在 List.Surface 中统一开启（R-01） -->
            <Grid Grid.Row="1">
                <ListBox x:Name="FileList"
                         ItemsSource="{Binding Entries}"
                         SelectionMode="Extended"
                         AllowDrop="True"
                         SelectionChanged="OnFileSelectionChanged"
                         PreviewMouseRightButtonDown="OnFileRightButtonDown"
                         PreviewMouseLeftButtonDown="OnFileDragStart"
                         PreviewMouseLeftButtonUp="OnFileLeftButtonUp"
                         PreviewMouseDown="OnFileMouseDown"
                         PreviewMouseMove="OnFileDragMove"
                         DragOver="OnFileDragOver"
                         DragLeave="OnFileDragLeave"
                         Drop="OnFileDrop"
                         MouseDoubleClick="OnFileDoubleClick"
                         PreviewKeyDown="OnFileListKeyDown"
                         GotKeyboardFocus="OnFileListGotFocus"
                         Tag="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:PaneView}}}">
                    <!--
                        右键菜单。ContextMenu 不在可视树里，拿不到窗口的 DataContext，
                        因此用 PlacementTarget（= 本 ListBox）的 Tag 把窗口传进去，
                        Command 绑定到窗口上的命令属性。键位提示由代码按快捷键表填入。
                    -->
                    <ListBox.ContextMenu>
                        <ContextMenu Style="{StaticResource ContextMenu.Default}"
                                     Opened="OnContextMenuOpened"
                                     DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                            <MenuItem Style="{StaticResource MenuItem.Default}"
                                      Header="{loc:Tr Key=Menu.Open}"
                                      Command="{Binding OpenItemCommand}"/>
                            <Separator Style="{StaticResource Menu.Separator}"/>
                            <MenuItem Style="{StaticResource MenuItem.Default}"
                                      Header="{loc:Tr Key=Menu.NewFolder}"
                                      Command="{Binding NewFolderCommand}"/>
                            <MenuItem Style="{StaticResource MenuItem.Default}"
                                      Header="{loc:Tr Key=Menu.NewTextFile}"
                                      Command="{Binding NewFileCommand}"/>
                            <MenuItem Style="{StaticResource MenuItem.Default}"
                                      Header="{loc:Tr Key=Menu.Rename}"
                                      Command="{Binding RenameCommand}"/>
                            <Separator Style="{StaticResource Menu.Separator}"/>
                            <MenuItem Style="{StaticResource MenuItem.Default}"
                                      Header="{loc:Tr Key=Menu.Copy}"
                                      Command="{Binding CopyItemsCommand}"/>
                            <MenuItem Style="{StaticResource MenuItem.Default}"
                                      Header="{loc:Tr Key=Menu.Cut}"
                                      Command="{Binding CutItemsCommand}"/>
                            <MenuItem Style="{StaticResource MenuItem.Default}"
                                      Header="{loc:Tr Key=Menu.Paste}"
                                      Command="{Binding PasteCommand}"/>
                            <Separator Style="{StaticResource Menu.Separator}"/>
                            <MenuItem Style="{StaticResource MenuItem.Default}"
                                      Header="{loc:Tr Key=Menu.Delete}"
                                      Command="{Binding DeleteCommand}"/>
                            <MenuItem Style="{StaticResource MenuItem.Default}"
                                      Header="{loc:Tr Key=Menu.DeletePermanent}"
                                      Command="{Binding DeletePermanentCommand}"/>
                            <Separator Style="{StaticResource Menu.Separator}"/>
                            <MenuItem Style="{StaticResource MenuItem.Default}"
                                      Header="{loc:Tr Key=Menu.CopyPath}"
                                      Command="{Binding CopyPathCommand}"/>
                            <MenuItem Style="{StaticResource MenuItem.Default}"
                                      Header="{loc:Tr Key=Menu.CalculateSize}"
                                      ToolTip="{loc:Tr Key=Menu.CalculateSize.Tip}"
                                      Command="{Binding CalculateSizeCommand}"/>
                            <MenuItem Style="{StaticResource MenuItem.Default}"
                                      Header="{loc:Tr Key=Menu.Properties}"
                                      Command="{Binding PropertiesCommand}"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.Style>
                        <Style TargetType="ListBox" BasedOn="{StaticResource List.Surface}">
                            <Setter Property="ItemTemplate" Value="{StaticResource Row.Details}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsListView}" Value="True">
                                    <Setter Property="ItemTemplate" Value="{StaticResource Row.List}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>
                </ListBox>

                <!-- 空目录提示：只在加载完成且无条目时出现，且不吃鼠标事件。
                     打不开的目录同样是 0 项，此时必须换成"无法访问"，否则会和状态栏互相矛盾。 -->
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
                            <Setter Property="Text" Value="{loc:Tr Key=Empty.Folder}"/>
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <!-- 加载完成且无条目 → 显示；后面的触发器优先级更高，用它挡住启动瞬间 -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Entries.Count}" Value="0"/>
                                        <Condition Binding="{Binding IsLoading}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                                <DataTrigger Binding="{Binding HasNavigationError}" Value="True">
                                    <Setter Property="Text" Value="{loc:Tr Key=Empty.Inaccessible}"/>
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Entries.Count}" Value="0"/>
                                        <Condition Binding="{Binding CurrentPath}" Value=""/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>

        <!-- 状态栏：左侧数量与耗时，右侧选中统计，中间提示 -->
        <Border x:Name="StatusBarHost"
                Grid.Row="2"
                Height="{DynamicResource Size.StatusBar.Height}"
                Background="{DynamicResource Brush.Surface.Window}"
                BorderBrush="{DynamicResource Brush.Border.Hairline}"
                BorderThickness="0,1,0,0">
            <Grid Margin="{StaticResource Padding.StatusBar}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Style="{StaticResource Text.Caption}"
                           Text="{Binding StatusText}"/>

                <TextBlock Grid.Column="1"
                           Margin="12,0,12,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource Text.Caption}"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding HintText}"/>

                <!-- 计算文件夹大小期间的进度与取消（FR-6.16）。
                     放在选中统计的位置而不是另起一行：状态栏只有 28px 高，
                     多一行会把两块内容一起挤扁。计算中让位给进度，结束后自动换回。 -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCalculatingSize}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock MaxWidth="360"
                               VerticalAlignment="Center"
                               Style="{StaticResource Text.Caption}"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding SizeProgressText}"/>
                    <Button Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource Button.Link}"
                            Content="{loc:Tr Key=Common.Cancel}"
                            Click="OnCancelFolderSize"/>
                </StackPanel>

                <TextBlock Grid.Column="3"
                           VerticalAlignment="Center"
                           Text="{Binding SelectionText}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCalculatingSize}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
        </Grid>
    </Border>
</UserControl>
