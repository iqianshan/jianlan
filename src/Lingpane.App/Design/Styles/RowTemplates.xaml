<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Lingpane.App.Converters">

    <!--
        行模板。列宽必须与主窗口列头完全一致，否则排序箭头会指在错误的列上。
        规则 R-02：单行可视元素不超过 5 个（图标 + 名称 + 日期 + 类型 + 大小）。

        为什么放在独立字典里：视图切换要在多个 DataTemplate 之间替换，
        DataTemplate 必须是资源而不是内联模板，才可能被 Style 的 Setter 引用。
    -->

    <DataTemplate x:Key="Row.Details">
        <Grid Height="{DynamicResource Size.Row.Active}"
              Margin="{StaticResource Padding.Row}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 标签点槽位：始终占位，否则有标签的行文件名会整体右移（规则 3.2） -->
            <Border Grid.Column="0" Width="{DynamicResource Size.Tag.Gutter}"/>

            <Image Grid.Column="1"
                   Width="{DynamicResource Size.Icon.List}"
                   Height="{DynamicResource Size.Icon.List}"
                   Source="{Binding IconToken,
                            Converter={x:Static conv:IconKeyToImageConverter.Instance}}"/>

            <TextBlock Grid.Column="2"
                       Margin="8,0,8,0"
                       Style="{StaticResource Text.Row}"
                       Text="{Binding DisplayName}"
                       ToolTip="{Binding Name}"/>

            <TextBlock Grid.Column="3"
                       Width="{DynamicResource Column.Date.Width}"
                       Style="{StaticResource Text.Secondary}"
                       Typography.NumeralAlignment="Tabular"
                       Text="{Binding DateText}"/>

            <TextBlock Grid.Column="4"
                       Width="{DynamicResource Column.Type.Width}"
                       Style="{StaticResource Text.Secondary}"
                       Text="{Binding TypeText}"/>

            <TextBlock Grid.Column="5"
                       Width="{DynamicResource Column.Size.Width}"
                       Style="{StaticResource Text.Number}"
                       Text="{Binding SizeText}"/>
        </Grid>
    </DataTemplate>

    <!-- 列表视图：只有图标与名称，行更矮，适合快速扫读 -->
    <DataTemplate x:Key="Row.List">
        <Grid Height="{DynamicResource Size.Row.Comfortable}"
              Margin="{StaticResource Padding.Row}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="{DynamicResource Size.Tag.Gutter}"/>

            <Image Grid.Column="1"
                   Width="{DynamicResource Size.Icon.List}"
                   Height="{DynamicResource Size.Icon.List}"
                   Source="{Binding IconToken,
                            Converter={x:Static conv:IconKeyToImageConverter.Instance}}"/>

            <TextBlock Grid.Column="2"
                       Margin="8,0,8,0"
                       Style="{StaticResource Text.Row}"
                       Text="{Binding DisplayName}"
                       ToolTip="{Binding Name}"/>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
