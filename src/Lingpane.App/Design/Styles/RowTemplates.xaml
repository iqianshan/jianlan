<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Lingpane.App.Converters">

    <!--
        行模板。列宽必须与主窗口列头完全一致，否则排序箭头会指在错误的列上。
        规则 R-02：单行可视元素不超过 5 个（图标 + 名称 + 日期 + 类型 + 大小）。

        为什么放在独立字典里：视图切换要在多个 DataTemplate 之间替换，
        DataTemplate 必须是资源而不是内联模板，才可能被 Style 的 Setter 引用。
    -->

    <!-- 标签圆点没有标签时整个不画：只靠 Fill 为 null 会留下描边那圈空心小环，
         看起来像一个没勾的复选框（走查时一眼就看出来了）。 -->
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

    <Style x:Key="Tag.Dot" TargetType="Ellipse">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="Stroke" Value="{DynamicResource Brush.Border.Strong}"/>
        <Setter Property="StrokeThickness" Value="0.5"/>
        <Setter Property="Fill" Value="{Binding Tags, Converter={x:Static conv:TagColorsToBrushConverter.Instance}}"/>
        <Setter Property="Visibility" Value="{Binding HasTags, Converter={StaticResource BoolToVisibility}}"/>
    </Style>

    <DataTemplate x:Key="Row.Details">
        <Grid Height="{DynamicResource Size.Row.Active}"
              Margin="{StaticResource Padding.Row}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 标签圆点槽位（FR-4.1.4）：**始终占位**，否则有标签的行文件名会整体右移（规则 3.2）。
                 外层 Border 保 12px 宽度（与列头那个占位一致），圆点在中间。
                 没有标签时 Fill 为 null，圆点自然不可见——不必再绑一个 Visibility。
                 描边用来救"黑"色标签：深色主题下纯黑填充在窗口底色上等于没有。 -->
            <Border Grid.Column="0" Width="{DynamicResource Size.Tag.Gutter}">
                <Ellipse Style="{StaticResource Tag.Dot}"/>
            </Border>

            <Image Grid.Column="1"
                   Width="{DynamicResource Size.Icon.List}"
                   Height="{DynamicResource Size.Icon.List}"
                   Source="{Binding IconToken,
                            Converter={x:Static conv:IconKeyToImageConverter.Instance}}"/>

            <TextBlock Grid.Column="2"
                       Margin="8,0,8,0"
                       Style="{StaticResource Text.Row}"
                       Text="{Binding DisplayName}"
                       ToolTip="{Binding Name}"/>

            <!-- 三个数据列的槽位与显隐跟着列配置走（FR-6.4）。资源由 PaneView 写入
                 它自己的资源字典，双窗格各自一份，互不干扰。 -->
            <!-- 数据列右侧留 8px：列宽是"单元格宽"，文字贴着列边界时，
                 两列相邻的内容会连成一片（换序后「1 B」与「11-09 11:20」粘在一起）。
                 Padding 只缩可用文字区，不改元素宽度，因此列头与行仍然对齐。 -->
            <TextBlock Grid.Column="{DynamicResource Column.Date.Slot}"
                       Width="{DynamicResource Column.Date.Width}"
                       Padding="0,0,8,0"
                       Visibility="{DynamicResource Column.Date.Visible}"
                       Style="{StaticResource Text.Secondary}"
                       Typography.NumeralAlignment="Tabular"
                       Text="{Binding DateText}"/>

            <TextBlock Grid.Column="{DynamicResource Column.Type.Slot}"
                       Width="{DynamicResource Column.Type.Width}"
                       Padding="0,0,8,0"
                       Visibility="{DynamicResource Column.Type.Visible}"
                       Style="{StaticResource Text.Secondary}"
                       Text="{Binding TypeText}"/>

            <TextBlock Grid.Column="{DynamicResource Column.Size.Slot}"
                       Width="{DynamicResource Column.Size.Width}"
                       Padding="0,0,8,0"
                       Visibility="{DynamicResource Column.Size.Visible}"
                       Style="{StaticResource Text.Number}"
                       Text="{Binding SizeText}"/>
        </Grid>
    </DataTemplate>

    <!-- 列表视图：只有图标与名称，行更矮，适合快速扫读 -->
    <DataTemplate x:Key="Row.List">
        <Grid Height="{DynamicResource Size.Row.Comfortable}"
              Margin="{StaticResource Padding.Row}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="{DynamicResource Size.Tag.Gutter}">
                <Ellipse Style="{StaticResource Tag.Dot}"/>
            </Border>

            <Image Grid.Column="1"
                   Width="{DynamicResource Size.Icon.List}"
                   Height="{DynamicResource Size.Icon.List}"
                   Source="{Binding IconToken,
                            Converter={x:Static conv:IconKeyToImageConverter.Instance}}"/>

            <TextBlock Grid.Column="2"
                       Margin="8,0,8,0"
                       Style="{StaticResource Text.Row}"
                       Text="{Binding DisplayName}"
                       ToolTip="{Binding Name}"/>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
