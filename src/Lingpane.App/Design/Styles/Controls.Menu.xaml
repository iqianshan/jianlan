<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        右键菜单最小样式集。
        WPF 默认 ContextMenu/MenuItem 用的是系统配色，深色主题下是一块突兀的白底，
        这里只覆盖用得到的部分：无图标、无勾选态。
        子菜单有了（FR-7.5 的颜色/图标预设），模板里对应一段 Popup 与一个右侧箭头；
        勾选态仍未用到，将来要加 IsCheckable 时再补分支。
    -->

    <Style x:Key="ContextMenu.Default" TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Window}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Hairline}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource BorderThickness.Hairline}"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource CornerRadius.Control}"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel IsItemsHost="True"
                                    KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MenuItem.Default" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}"/>
        <Setter Property="Padding" Value="8,5,8,5"/>
        <Setter Property="MinWidth" Value="200"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            CornerRadius="{StaticResource CornerRadius.Control}"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center"/>
                            <!-- 键位提示由代码按 KeyBindings 表填入，XAML 里不写死 -->
                            <TextBlock x:Name="Gesture"
                                       Grid.Column="1"
                                       Margin="24,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="{TemplateBinding InputGestureText}"
                                       Style="{StaticResource Text.Caption}"/>
                            <!-- 有子项时右侧出箭头（见下面的 SubmenuHeader 触发器）。
                                 E76C 与 IconGlyphs.ChevronRight 同一个码位。 -->
                            <TextBlock x:Name="Arrow"
                                       Grid.Column="2"
                                       Margin="24,0,0,0"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource Font.Family.Icon}"
                                       FontSize="{DynamicResource Font.Size.Caption}"
                                       Text="&#xE76C;"
                                       Visibility="Collapsed"/>

                            <!-- 子菜单宿主。MenuItem 自己会在悬停/右键时置 IsSubmenuOpen，
                                 模板里必须有这个 Popup（名字固定为 PART_Popup）它才有地方展开。 -->
                            <Popup x:Name="PART_Popup"
                                   Grid.Column="0"
                                   Placement="Right"
                                   HorizontalOffset="-4"
                                   VerticalOffset="-6"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="None">
                                <!-- 颜色写死与 ContextMenu.Default 一致：MenuItem 自身没有
                                     Background/BorderBrush（这两个属性不继承），
                                     TemplateBinding 过来会得到全透明的面板。 -->
                                <Border Background="{DynamicResource Brush.Surface.Window}"
                                        BorderBrush="{DynamicResource Brush.Border.Hairline}"
                                        BorderThickness="{DynamicResource BorderThickness.Hairline}"
                                        CornerRadius="{StaticResource CornerRadius.Control}"
                                        Padding="4">
                                    <StackPanel IsItemsHost="True"
                                                KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Brush.Surface.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}"/>
                        </Trigger>
                        <!-- 有子项才出箭头。Role 是 MenuItem 的只读依赖属性，
                             ContextMenu 里带子项的项算 SubmenuHeader。 -->
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Menu.Separator" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1"
                            Margin="6,4,6,4"
                            Background="{DynamicResource Brush.Border.Hairline}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

