<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!--
        高对比度主题 v1.0
        本字典不定义颜色，全部映射到系统高对比度方案（FR-5.1.2 / AC-06）。
        规则：颜色语义在此模式下全部失效——彩色标签降级为单色圆点，
              除选中行外一律禁止反白，禁止半透明填充与阴影。
    -->
    <sys:String x:Key="Theme.Name">HighContrast</sys:String>

    <!--
        注意：本主题没有 Color.* 中间层，画刷直接用 {x:Static SystemColors.XxxColor} 上色。
        原因是 <Color x:Key="...">{x:Static ...}</Color> 这种写法在 XAML 里非法——
        <Color> 的文本内容会交给 ColorConverter 按字符串解析，结果是启动即抛
        XamlParseException「无法从文本“{x:Static SystemColors.WindowColor}”创建 Color」，
        崩溃日志里表现为 Theme 为 HighContrast、Show() 阶段挂掉。
        {x:Static} 只能用在 Color 类型的“属性”上（如 SolidColorBrush.Color），
        不能当元素内容。Color.* 目前没有外部消费者，只有本文件用来拼画刷，故直接省略。
    -->

    <SolidColorBrush x:Key="Brush.Surface.Window" Color="{x:Static SystemColors.WindowColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Surface.Content" Color="{x:Static SystemColors.WindowColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Surface.Sidebar" Color="{x:Static SystemColors.WindowColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Surface.Floating" Color="{x:Static SystemColors.WindowColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Surface.Interactive" Color="{x:Static SystemColors.WindowColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="{x:Static SystemColors.HighlightColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Surface.Pressed" Color="{x:Static SystemColors.HighlightColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Surface.Selected" Color="{x:Static SystemColors.HighlightColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Surface.SelectedInactive" Color="{x:Static SystemColors.HighlightColor}" po:Freeze="True"/>

    <SolidColorBrush x:Key="Brush.Border.Window" Color="{x:Static SystemColors.WindowTextColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="{x:Static SystemColors.WindowTextColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Border.Hairline" Color="{x:Static SystemColors.WindowTextColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Border.Focus" Color="{x:Static SystemColors.HighlightColor}" po:Freeze="True"/>

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{x:Static SystemColors.WindowTextColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{x:Static SystemColors.WindowTextColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="{x:Static SystemColors.GrayTextColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="{x:Static SystemColors.GrayTextColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="{x:Static SystemColors.HighlightTextColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Text.OnSelected" Color="{x:Static SystemColors.HighlightTextColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Text.Link" Color="{x:Static SystemColors.HotTrackColor}" po:Freeze="True"/>

    <SolidColorBrush x:Key="Brush.Icon.Primary" Color="{x:Static SystemColors.WindowTextColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Icon.Secondary" Color="{x:Static SystemColors.WindowTextColor}" po:Freeze="True"/>

    <SolidColorBrush x:Key="Brush.Accent.Default" Color="{x:Static SystemColors.HighlightColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{x:Static SystemColors.HighlightColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="{x:Static SystemColors.HighlightColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Accent.Subtle" Color="{x:Static SystemColors.HighlightColor}" po:Freeze="True"/>

    <SolidColorBrush x:Key="Brush.Status.Danger" Color="{x:Static SystemColors.WindowTextColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Status.Warning" Color="{x:Static SystemColors.WindowTextColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Status.Success" Color="{x:Static SystemColors.WindowTextColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Status.Info" Color="{x:Static SystemColors.WindowTextColor}" po:Freeze="True"/>

    <SolidColorBrush x:Key="Brush.Tag.Red" Color="{x:Static SystemColors.WindowTextColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Tag.Orange" Color="{x:Static SystemColors.WindowTextColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Tag.Yellow" Color="{x:Static SystemColors.WindowTextColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Tag.Green" Color="{x:Static SystemColors.WindowTextColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Tag.Blue" Color="{x:Static SystemColors.WindowTextColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Tag.Purple" Color="{x:Static SystemColors.WindowTextColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Tag.Gray" Color="{x:Static SystemColors.WindowTextColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Tag.Black" Color="{x:Static SystemColors.WindowTextColor}" po:Freeze="True"/>

    <SolidColorBrush x:Key="Brush.Scroll.Thumb" Color="{x:Static SystemColors.WindowTextColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Scroll.ThumbHover" Color="{x:Static SystemColors.WindowTextColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Overlay.Scrim" Color="{x:Static SystemColors.ControlColor}" po:Freeze="True"/>

</ResourceDictionary>
