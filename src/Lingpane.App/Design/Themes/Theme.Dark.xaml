<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!-- 深色主题 v1.0 · 强调色提亮至 #5B8DEF 以维持 4.5:1 -->
    <sys:String x:Key="Theme.Name">Dark</sys:String>

    <!-- 表面 L0–L3 -->
    <Color x:Key="Color.Surface.Window">#FF1A1A1C</Color>
    <Color x:Key="Color.Surface.Content">#FF202023</Color>
    <Color x:Key="Color.Surface.Sidebar">#FF1C1C1F</Color>
    <Color x:Key="Color.Surface.Floating">#FF26262A</Color>
    <Color x:Key="Color.Surface.Interactive">#FF2A2A2F</Color>
    <Color x:Key="Color.Surface.Hover">#FF26262A</Color>
    <Color x:Key="Color.Surface.Pressed">#FF2E2E33</Color>
    <Color x:Key="Color.Surface.Selected">#FF25303F</Color>
    <Color x:Key="Color.Surface.SelectedInactive">#FF26262A</Color>

    <!-- 描边 -->
    <Color x:Key="Color.Border.Window">#FF45454D</Color>
    <Color x:Key="Color.Border.Strong">#FF3A3A42</Color>
    <Color x:Key="Color.Border.Hairline">#FF2A2A2F</Color>
    <Color x:Key="Color.Border.Focus">#FF5B8DEF</Color>

    <!-- 文字 -->
    <Color x:Key="Color.Text.Primary">#FFEDEDF0</Color>
    <Color x:Key="Color.Text.Secondary">#FF9A9AA5</Color>
    <Color x:Key="Color.Text.Tertiary">#FF6E6E7A</Color>
    <Color x:Key="Color.Text.Disabled">#FF55555F</Color>
    <Color x:Key="Color.Text.OnAccent">#FFFFFFFF</Color>
    <Color x:Key="Color.Text.OnSelected">#FFF2F2F5</Color>
    <Color x:Key="Color.Text.Link">#FF5B8DEF</Color>

    <!-- 图标 -->
    <Color x:Key="Color.Icon.Primary">#FFB9B9C4</Color>
    <Color x:Key="Color.Icon.Secondary">#FF7A7A85</Color>

    <!-- 强调色 -->
    <Color x:Key="Color.Accent.Default">#FF5B8DEF</Color>
    <Color x:Key="Color.Accent.Hover">#FF6F9BF2</Color>
    <Color x:Key="Color.Accent.Pressed">#FF4A7BD8</Color>
    <Color x:Key="Color.Accent.Subtle">#FF25303F</Color>

    <!-- 状态 -->
    <Color x:Key="Color.Status.Danger">#FFF07171</Color>
    <Color x:Key="Color.Status.Warning">#FFE0A33E</Color>
    <Color x:Key="Color.Status.Success">#FF4FBE84</Color>
    <Color x:Key="Color.Status.Info">#FF5B8DEF</Color>

    <!-- 彩色标签（深色下统一提亮，避免在 #202023 上发暗） -->
    <Color x:Key="Color.Tag.Red">#FFF07171</Color>
    <Color x:Key="Color.Tag.Orange">#FFFF8C42</Color>
    <Color x:Key="Color.Tag.Yellow">#FFF2C94C</Color>
    <Color x:Key="Color.Tag.Green">#FF4FBE84</Color>
    <Color x:Key="Color.Tag.Blue">#FF5B8DEF</Color>
    <Color x:Key="Color.Tag.Purple">#FFB07BE0</Color>
    <Color x:Key="Color.Tag.Gray">#FF8B8D98</Color>
    <Color x:Key="Color.Tag.Black">#FFC9C9D2</Color>

    <!-- 滚动条 / 遮罩 -->
    <Color x:Key="Color.Scroll.Thumb">#FF3E3E46</Color>
    <Color x:Key="Color.Scroll.ThumbHover">#FF55555F</Color>
    <Color x:Key="Color.Overlay.Scrim">#99000000</Color>

    <SolidColorBrush x:Key="Brush.Surface.Window" Color="{StaticResource Color.Surface.Window}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Surface.Content" Color="{StaticResource Color.Surface.Content}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Surface.Sidebar" Color="{StaticResource Color.Surface.Sidebar}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Surface.Floating" Color="{StaticResource Color.Surface.Floating}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Surface.Interactive" Color="{StaticResource Color.Surface.Interactive}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="{StaticResource Color.Surface.Hover}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Surface.Pressed" Color="{StaticResource Color.Surface.Pressed}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Surface.Selected" Color="{StaticResource Color.Surface.Selected}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Surface.SelectedInactive" Color="{StaticResource Color.Surface.SelectedInactive}" po:Freeze="True"/>

    <SolidColorBrush x:Key="Brush.Border.Window" Color="{StaticResource Color.Border.Window}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="{StaticResource Color.Border.Strong}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Border.Hairline" Color="{StaticResource Color.Border.Hairline}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Border.Focus" Color="{StaticResource Color.Border.Focus}" po:Freeze="True"/>

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="{StaticResource Color.Text.Tertiary}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="{StaticResource Color.Text.Disabled}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="{StaticResource Color.Text.OnAccent}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Text.OnSelected" Color="{StaticResource Color.Text.OnSelected}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Text.Link" Color="{StaticResource Color.Text.Link}" po:Freeze="True"/>

    <SolidColorBrush x:Key="Brush.Icon.Primary" Color="{StaticResource Color.Icon.Primary}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Icon.Secondary" Color="{StaticResource Color.Icon.Secondary}" po:Freeze="True"/>

    <SolidColorBrush x:Key="Brush.Accent.Default" Color="{StaticResource Color.Accent.Default}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{StaticResource Color.Accent.Hover}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="{StaticResource Color.Accent.Pressed}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Accent.Subtle" Color="{StaticResource Color.Accent.Subtle}" po:Freeze="True"/>

    <SolidColorBrush x:Key="Brush.Status.Danger" Color="{StaticResource Color.Status.Danger}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Status.Warning" Color="{StaticResource Color.Status.Warning}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Status.Success" Color="{StaticResource Color.Status.Success}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Status.Info" Color="{StaticResource Color.Status.Info}" po:Freeze="True"/>

    <SolidColorBrush x:Key="Brush.Tag.Red" Color="{StaticResource Color.Tag.Red}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Tag.Orange" Color="{StaticResource Color.Tag.Orange}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Tag.Yellow" Color="{StaticResource Color.Tag.Yellow}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Tag.Green" Color="{StaticResource Color.Tag.Green}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Tag.Blue" Color="{StaticResource Color.Tag.Blue}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Tag.Purple" Color="{StaticResource Color.Tag.Purple}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Tag.Gray" Color="{StaticResource Color.Tag.Gray}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Tag.Black" Color="{StaticResource Color.Tag.Black}" po:Freeze="True"/>

    <SolidColorBrush x:Key="Brush.Scroll.Thumb" Color="{StaticResource Color.Scroll.Thumb}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Scroll.ThumbHover" Color="{StaticResource Color.Scroll.ThumbHover}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Overlay.Scrim" Color="{StaticResource Color.Overlay.Scrim}" po:Freeze="True"/>

</ResourceDictionary>
