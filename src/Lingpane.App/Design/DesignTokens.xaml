<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        Lingpane Design Tokens  v1.0
        基线：浅色 / 深色 / 高对比度 三套；强调色 #2F6BE0；默认密度 32px；字号 8–24pt 可调。

        使用规则：
        1. 本文件只放"与主题无关"的 token。颜色 token 在 Themes/ 下的三份字典中。
        2. 静态 token（动效、圆角、层级）
              → StaticResource。
           随字号变化的 token（Font.Size.* / Font.LineHeight.* / 行高 / 列宽 / 图标档位）
              → DynamicResource，运行期由 FontScaleService 覆盖（见 §15 字号缩放）。
           颜色 / 画刷 → DynamicResource（主题切换需实时生效，FR-5.1.1 <100ms 无闪烁）。
        3. 界面 XAML 中禁止出现颜色字面量、魔法数字、硬编码时长。

        字号：设置项为 8–24pt（步进 1，默认跟随系统），运行期换算为 px 后
              以 Font.Size.Row 为唯一基准，其余字号、行高、列宽由 FontMetrics 派生写回本表。
              界面不得自行按比例计算任何数值；图标尺寸固定，不随字号变化（FONT-06）。

        主题切换：
        本文件的 MergedDictionaries 内合并当前主题字典。切换统一走 ThemeService.Apply，
        不要在别处改 Source。注意 Theme.Name 在内层字典里，顶层的
        MergedDictionaries[i].Contains("Theme.Name") 查不到，必须扫一层嵌套：

            foreach (var outer in Application.Current.Resources.MergedDictionaries)
                for (int i = 0; i < outer.MergedDictionaries.Count; i++)
                    if (outer.MergedDictionaries[i].Contains("Theme.Name"))
                        outer.MergedDictionaries[i].Source = new Uri("Themes/Theme.Dark.xaml", UriKind.Relative);
    -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Theme.Light.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ============ 01 字体 ============ -->

    <FontFamily x:Key="Font.Family.UI">Microsoft YaHei UI, Segoe UI, Segoe UI Emoji</FontFamily>
    <FontFamily x:Key="Font.Family.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>
    <FontFamily x:Key="Font.Family.Icon">Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="Font.Family.Icon.Fluent">Segoe Fluent Icons</FontFamily>

    <sys:Double x:Key="Font.Size.Caption">11</sys:Double>
    <sys:Double x:Key="Font.Size.Body">12</sys:Double>
    <sys:Double x:Key="Font.Size.Row">13</sys:Double>
    <sys:Double x:Key="Font.Size.Subtitle">15</sys:Double>
    <sys:Double x:Key="Font.Size.Title">20</sys:Double>
    <sys:Double x:Key="Font.Size.Display">28</sys:Double>
    <!-- 窗口按钮图标（FR-10.11）。10px 是 MDL2 的 chrome 字形画出来正好 10×10 的尺寸，
         固定不随字号放大（FONT-06）：这是"系统键"，不是正文。 -->
    <sys:Double x:Key="Font.Size.WindowControl">10</sys:Double>

    <FontWeight x:Key="Font.Weight.Normal">Normal</FontWeight>
    <FontWeight x:Key="Font.Weight.Emphasis">Bold</FontWeight>

    <!-- 字号缩放：唯一变量。1.0 = 行字号 13px。运行期由 FontScaleService 写入，只读消费 -->
    <sys:Double x:Key="Font.Scale">1</sys:Double>

    <!-- 以下字号均为 100% 基线值，运行期会被 FontScaleService 覆盖，禁止在样式里写死 -->
    <sys:Double x:Key="Font.LineHeight.Caption">16</sys:Double>
    <sys:Double x:Key="Font.LineHeight.Body">20</sys:Double>
    <sys:Double x:Key="Font.LineHeight.Row">20</sys:Double>
    <sys:Double x:Key="Font.LineHeight.Subtitle">22</sys:Double>

    <!-- ============ 02 间距（4px 栅格，禁止非 4 倍数） ============ -->

    <sys:Double x:Key="Space.1">4</sys:Double>
    <sys:Double x:Key="Space.2">8</sys:Double>
    <sys:Double x:Key="Space.3">12</sys:Double>
    <sys:Double x:Key="Space.4">16</sys:Double>
    <sys:Double x:Key="Space.5">20</sys:Double>
    <sys:Double x:Key="Space.6">24</sys:Double>
    <sys:Double x:Key="Space.8">32</sys:Double>
    <sys:Double x:Key="Space.10">40</sys:Double>

    <!-- ============ 03 尺寸 ============ -->

    <sys:Double x:Key="Size.Row.Comfortable">32</sys:Double>
    <sys:Double x:Key="Size.Row.Compact">26</sys:Double>
    <!-- 当前生效行高（按密度取上面两档之一），列表与导航统一绑定此键 -->
    <sys:Double x:Key="Size.Row.Active">32</sys:Double>
    <sys:Double x:Key="Size.Row.Header">30</sys:Double>

    <sys:Double x:Key="Size.Tab.Height">30</sys:Double>
    <sys:Double x:Key="Size.Tab.MinWidth">100</sys:Double>
    <sys:Double x:Key="Size.Tab.MaxWidth">200</sys:Double>

    <sys:Double x:Key="Size.Toolbar.Height">48</sys:Double>
    <sys:Double x:Key="Size.StatusBar.Height">28</sys:Double>
    <!-- 标题条（FR-10.11）。40 与资源管理器一致：30px 的标签居中放进去，上下各 5px 余白。
         随字号变化，运行期由 FontScaleService 写回。 -->
    <sys:Double x:Key="Size.TitleBar.Height">40</sys:Double>

    <!-- 窗口按钮（FR-10.11）：46×32 是 Windows 自己的尺寸，改小会失去"系统键"的手感 -->
    <sys:Double x:Key="Size.WindowControl.Width">46</sys:Double>
    <sys:Double x:Key="Size.WindowControl.Height">32</sys:Double>
    <!-- 三个按钮的总宽，标签栏据此让出右侧空间，避免标签被按钮压住 -->
    <sys:Double x:Key="Size.WindowControls.Width">138</sys:Double>

    <!-- 工具栏搜索框（FR-6.13）。150 是"能看见 8~10 个汉字"的宽度：
         再宽会在分屏时把地址栏压没，再窄连一个常见关键词都显示不全。
         不随语言变——地址栏才是按语言给宽度的那个控件。
         分屏后每个窗格只有半个窗口，靠下面两档收窄，见 PaneView.ApplySearchBoxWidth。 -->
    <sys:Double x:Key="Size.Search.Width">150</sys:Double>
    <sys:Double x:Key="Size.Search.Width.Narrow">120</sys:Double>
    <!-- 分屏后每格只剩约 420px：四个导航按钮 + 三个视图按钮已经占掉 240，
         搜索框再宽一点地址栏就整条消失（实测 96 时左窗格面包屑一点也看不到）。
         压缩态收到 40——此时它只剩一个放大镜的形状，点一下（或 Ctrl+F）会展开到
         150 并接管地址栏的位置，输入完失焦/清空再收回去。见 PaneView 的搜索框宽度分档。 -->
    <sys:Double x:Key="Size.Search.Width.Compact">40</sys:Double>

    <sys:Double x:Key="Size.Nav.Item.Height">28</sys:Double>
    <sys:Double x:Key="Size.Nav.Width.Default">184</sys:Double>
    <sys:Double x:Key="Size.Nav.Width.Min">160</sys:Double>
    <sys:Double x:Key="Size.Nav.Width.Max">320</sys:Double>
    <sys:Double x:Key="Size.Nav.Indent">16</sys:Double>

    <sys:Double x:Key="Size.Icon.Small">16</sys:Double>
    <sys:Double x:Key="Size.Icon.Medium">20</sys:Double>
    <sys:Double x:Key="Size.Icon.Large">24</sys:Double>
    <!-- 文件行图标：固定 16，不随字号变化（FONT-06）；大图标视图另取 Size.Icon.Large -->
    <sys:Double x:Key="Size.Icon.List">16</sys:Double>
    <!-- 行内缩略图槽位（FR-6.6）：24 放在 32 的行高里，不上调行高也就塞得下。
         再大就得改行高，那会让"万项目录一秒扫完"这件事变难。 -->
    <sys:Double x:Key="Size.Icon.Thumb">24</sys:Double>

    <sys:Double x:Key="Size.Tag.Dot">6</sys:Double>
    <sys:Double x:Key="Size.Tag.Gutter">24</sys:Double>

    <!-- 小图标按钮的命中区（分区标题行尾的齿轮，FR-1.2.9）。
         固定 20 不随字号放大：图标尺寸本就不随字号变化（FONT-06），
         而它所在的那一行由 Caption 行高撑开，20 在最挤的 9pt 下也装得下。 -->
    <sys:Double x:Key="Size.IconButton.Small">20</sys:Double>

    <sys:Double x:Key="Size.ScrollBar.Thickness">10</sys:Double>
    <sys:Double x:Key="Size.Splitter.Thickness">6</sys:Double>
    <sys:Double x:Key="Size.Preview.MinWidth">240</sys:Double>
    <!-- 默认宽度。320 是"能看清一张缩略图 + 三行文件名"的下限，再窄预览就只剩图标了 -->
    <sys:Double x:Key="Size.Preview.DefaultWidth">320</sys:Double>
    <sys:Double x:Key="Size.Preview.MaxWidth">720</sys:Double>

    <!-- 设置页左侧分类导航的宽度区间。与侧栏同理：按内容取宽并夹住上下限。
         上限给到 360 是因为 24pt 下英文页名（"Privacy and storage"，19 字符约 360px）
         已经比侧栏的任何条目都长；默认字号下内容只有 80 出头，取不到这个上限。 -->
    <sys:Double x:Key="Size.Settings.Nav.Min">168</sys:Double>
    <sys:Double x:Key="Size.Settings.Nav.Max">360</sys:Double>

    <!-- 设置页下拉框宽度（12pt 基准值）。实际值由 FontMetrics 按字号覆写，
         这里只是首次加载前的兜底——写死会在 24pt 下把原文案截成前四个字母。 -->
    <sys:Double x:Key="Size.Combo.Width">300</sys:Double>
    <sys:Double x:Key="Size.Combo.Width.Narrow">120</sys:Double>

    <Thickness x:Key="Padding.Row">8,0,8,0</Thickness>
    <!-- 导航行左缩进 14 而不是 8：8px 时图标几乎贴着分隔线，整列看起来被挤在左边；
         选中底色块自己还内缩 4px，视觉上只剩 4px 留白。分区标题同取 14，
         让"分类名"与"条目图标"落在同一条竖线上（原来标题 12、条目 8，层级是反的）。 -->
    <Thickness x:Key="Padding.NavItem">14,0,8,0</Thickness>
    <Thickness x:Key="Padding.Toolbar">12,0,12,0</Thickness>
    <Thickness x:Key="Padding.MenuItem">12,6,12,6</Thickness>
    <Thickness x:Key="Padding.Dialog">20</Thickness>
    <Thickness x:Key="Padding.StatusBar">12,0,12,0</Thickness>

    <!-- ============ 04 圆角 ============ -->

    <sys:Double x:Key="Radius.Control">4</sys:Double>
    <sys:Double x:Key="Radius.Tab">7</sys:Double>
    <sys:Double x:Key="Radius.Menu">8</sys:Double>
    <sys:Double x:Key="Radius.Dialog">10</sys:Double>
    <sys:Double x:Key="Radius.Window">10</sys:Double>

    <CornerRadius x:Key="CornerRadius.Control">4</CornerRadius>
    <!-- 标签页（FR-10.11）：7px 是 ui-guidelines 规则 7.5 定的值，比控件圆角大一档——
         标签是"卡片"，不是"按钮"，圆角小了看不出是在标题栏里浮起来 -->
    <CornerRadius x:Key="CornerRadius.Tab">7</CornerRadius>
    <CornerRadius x:Key="CornerRadius.Menu">8</CornerRadius>
    <CornerRadius x:Key="CornerRadius.Dialog">10</CornerRadius>

    <!-- ============ 05 描边 ============ -->

    <Thickness x:Key="BorderThickness.Hairline">1</Thickness>
    <Thickness x:Key="BorderThickness.Focus">2</Thickness>
    <Thickness x:Key="BorderThickness.None">0</Thickness>

    <!-- ============ 06 动效（白名单只有三条） ============ -->

    <Duration x:Key="Duration.Hover">0:0:0.09</Duration>
    <Duration x:Key="Duration.Overlay">0:0:0.13</Duration>
    <Duration x:Key="Duration.Drop">0:0:0.18</Duration>

    <CubicEase x:Key="Easing.Standard" EasingMode="EaseOut"/>
    <CubicEase x:Key="Easing.Enter" EasingMode="EaseOut"/>

    <sys:Double x:Key="Motion.OverlayOffsetY">4</sys:Double>

    <!-- ============ 07 列表列宽 ============ -->

    <sys:Double x:Key="Column.Name.MinWidth">160</sys:Double>
    <sys:Double x:Key="Column.Date.Width">110</sys:Double>
    <sys:Double x:Key="Column.Type.Width">110</sys:Double>
    <sys:Double x:Key="Column.Size.Width">90</sys:Double>

    <sys:Double x:Key="Size.TabStrip.ScrollStep">60</sys:Double>

    <!-- ============ 08 层级 ============ -->

    <sys:Int32 x:Key="ZIndex.Dropdown">100</sys:Int32>
    <sys:Int32 x:Key="ZIndex.Dialog">200</sys:Int32>
    <sys:Int32 x:Key="ZIndex.ToolTip">300</sys:Int32>

</ResourceDictionary>
