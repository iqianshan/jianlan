<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>Lingpane.App</RootNamespace>
    <AssemblyName>Lingpane</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- 启动优先：ReadyToRun 由发布脚本控制，调试期关闭以加快构建 -->
    <PublishReadyToRun Condition="'$(Configuration)' == 'Release'">true</PublishReadyToRun>
    <TieredCompilationQuickJitForLoops>true</TieredCompilationQuickJitForLoops>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lingpane.Core\Lingpane.Core.csproj" />
  </ItemGroup>

  <!--
    exe 图标（资源管理器、任务栏、开始菜单、Alt+Tab）。ico 内 16/24/32/48/64/128/256 七档
    各自绘制，不是同一张大图缩放出来的——16px 那档去掉了横棂、描边加粗到 1.6px，
    直接缩会把窗格糊成一片。
  -->
  <PropertyGroup>
    <ApplicationIcon>Assets\Brand\lingpane.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\**\*" />
  </ItemGroup>

  <!--
    开源合规文件随产物落地（AC-10：发布包须含 LICENSE、NOTICE、第三方依赖许可清单）。
    三份都是仓库根目录的同一份，不复制副本——复制就意味着以后会有人只改其中一份。
    只在输出/发布目录里放一份链接，文件名保持原样，用户解压后一眼能看到。
  -->
  <ItemGroup>
    <None Include="..\..\LICENSE" Link="LICENSE"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\NOTICE" Link="NOTICE"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    同一份文本再以嵌入资源打一份（关于页的「查看许可证全文 / NOTICE / 依赖清单」读的是它）。
    不用"读 exe 旁边的文件"这条路：用户可能把 exe 单独拖到别处，也可能被杀软把
    散落的 .md 清掉，那时关于页就只剩三个点不动的按钮。多十几 KB 换"程序内一定能读到"。
    LogicalName 固定成 Legal.*，与 Services/LegalResources.cs 里的常量对应。
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="Legal.LICENSE" />
    <EmbeddedResource Include="..\..\NOTICE" LogicalName="Legal.NOTICE" />
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.md" LogicalName="Legal.ThirdParty" />
  </ItemGroup>

</Project>
