<Project>

  <!--
    全局编译属性。所有子项目自动继承，禁止在各 csproj 里重复定义。
    改这里等于改全部项目。
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <!-- 版权署名（LICENSE / NOTICE / 程序集信息一致） -->
    <Authors>谦山</Authors>
    <Company>谦山</Company>
    <Product>Lingpane</Product>
    <Copyright>Copyright © 2026 谦山</Copyright>

    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>

    <!--
      信息版号（关于页与 app.log 用的那个）。发版脚本 tools/release/publish.ps1 通过
      环境变量 InformationalVersion=0.1.0+<短commit> 写进来，让"哪一次构建"能从产物里读回来。
      这里给默认值，是为了本地直接 dotnet build 时不至于出现空版本串。

      关掉 SDK 的自动 commit 追加：它在 InformationalVersion 已含 "+" 时会拼成
      "0.1.0+abc123.<40 位 sha>"，两段 commit 叠在一起。短号由脚本自己取，
      因为它还要处理"这台机器没装 git"的发布场景。
    -->
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <!--
      保留中英两套附属资源。只写 en 会把 zh-Hans 卫星程序集裁掉，切中文后一片英文。
      伪语言 qps-ploc 只在显式传 -p:IncludePseudoLoc=true 时编入：
      它是走查用的诊断语言，混进正式发布包会白白多一个卫星目录。
    -->
    <SatelliteResourceLanguages Condition="'$(IncludePseudoLoc)' == 'true'">en;zh-Hans;qps-ploc</SatelliteResourceLanguages>
    <SatelliteResourceLanguages Condition="'$(IncludePseudoLoc)' != 'true'">en;zh-Hans</SatelliteResourceLanguages>

    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
  </PropertyGroup>

  <!-- Release 专属：性能优先的编译选项 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <TieredPGO>true</TieredPGO>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

</Project>
